# Database Configuration
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_NAME=platform

# JWT Secrets (IMPORTANT: Change these in production!)
JWT_ACCESS_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_IN_PRODUCTION

# Patient App JWT Secrets — منفصلة تماماً عن أسرار موظفي المنصة أعلاه
PATIENT_JWT_ACCESS_SECRET=CHANGE_THIS_PATIENT_ACCESS_SECRET_IN_PRODUCTION
PATIENT_JWT_REFRESH_SECRET=CHANGE_THIS_PATIENT_REFRESH_SECRET_IN_PRODUCTION

# JWT Token Expiration
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=30

# Firebase Cloud Messaging (push notifications للمريض) — اختياري، بدون هذا المتغيّر
# يبقى إنشاء الإشعار يعمل (يظهر بقائمة إشعارات التطبيق) لكن بدون push فعلي للجهاز.
# القيمة = محتوى ملف Firebase Service Account JSON كسطر واحد (minified).
# لا تضعي القيمة الحقيقية هنا أبداً — هذا الملف مثال فقط ويُرفع لـgit.
FCM_SERVICE_ACCOUNT_JSON=

# Instructions:
# 1. Copy this file to .env.production
# 2. Replace all CHANGE_THIS values with strong, random secrets
# 3. Never commit .env.production to git
# 4. Use strong passwords (minimum 32 characters, random)
#
# Example to generate a random secret:
# openssl rand -base64 32
