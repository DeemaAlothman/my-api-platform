generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["warehouse"]
}

// جدول شاهد فقط لإثبات أن الاتصال بقاعدة البيانات والـ migrations يعملان — لا معنى تشغيلياً له
model WarehouseMeta {
  id        Int      @id @default(autoincrement())
  note      String
  createdAt DateTime @default(now())

  @@map("warehouse_meta")
  @@schema("warehouse")
}

// ── بيانات أساسية (Master Data) — بدون أي منطق أرصدة أو حركات بعد ──────────

enum WarehouseType {
  MAIN
  QUARANTINE
  OTHER

  @@schema("warehouse")
}

model Warehouse {
  id                String        @id @default(uuid())
  code              String        @unique
  name              String
  type              WarehouseType @default(MAIN)
  location          String?
  isActive          Boolean       @default(true)
  managerEmployeeId String?       // users.employees.id — مرجع خارجي بلا FK
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  balances         StockBalance[]
  movements        StockMovement[]
  materialRequests MaterialRequest[]

  @@map("warehouses")
  @@schema("warehouse")
}

model Unit {
  id     String  @id @default(uuid())
  name   String
  symbol String?
  items  Item[]

  @@map("units")
  @@schema("warehouse")
}

model ItemCategory {
  id       String         @id @default(uuid())
  name     String
  nameAr   String?
  parentId String?
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  isActive Boolean        @default(true)
  items    Item[]

  @@map("item_categories")
  @@schema("warehouse")
}

model Supplier {
  id       String  @id @default(uuid())
  name     String
  phone    String?
  email    String?
  address  String?
  isActive Boolean @default(true)

  @@map("suppliers")
  @@schema("warehouse")
}

enum ItemType {
  COMPONENT
  CONSUMABLE
  SERVICE

  @@schema("warehouse")
}

model Item {
  id           String        @id @default(uuid())
  sku          String        @unique
  partCode     String?       @unique // مفتاح الربط مع مكوّنات الأطراف الصناعية (partCode)
  barcode      String?
  name         String
  nameAr       String?
  itemType     ItemType      @default(CONSUMABLE)
  categoryId   String?
  category     ItemCategory? @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id])
  manufacturer String?
  minStock     Decimal?      @db.Decimal(18, 3)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  balances             StockBalance[]
  movements            StockMovement[]
  materialRequestItems MaterialRequestItem[]

  @@index([categoryId])
  @@index([unitId])
  @@map("items")
  @@schema("warehouse")
}

// ── الأرصدة والحركات — بدون أي مستند شراء/بيع بعد، إدخال/إخراج يدوي فقط ────

model StockBalance {
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])

  onHandQty   Decimal   @default(0) @db.Decimal(18, 3)
  reservedQty Decimal   @default(0) @db.Decimal(18, 3)
  avgUnitCost Decimal?  @db.Decimal(18, 4)
  updatedAt   DateTime  @updatedAt

  @@id([warehouseId, itemId])
  @@map("stock_balances")
  @@schema("warehouse")
  // availableQty = onHandQty - reservedQty (يُشتق، لا يُخزَّن)
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  RESERVE // حجز عند الاعتماد — لا يغيّر onHand، يزيد reserved فقط
  ISSUE   // صرف فعلي لطلب مواد معتمد — ينقص onHand وreserved معاً

  @@schema("warehouse")
}

// حركة غير قابلة للتعديل — لا updatedAt عمداً
model StockMovement {
  id                String       @id @default(uuid())
  itemId            String
  item              Item         @relation(fields: [itemId], references: [id])
  warehouseId       String
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id])

  movementType      MovementType
  onHandDelta       Decimal      @default(0) @db.Decimal(18, 3)
  reservedDelta     Decimal      @default(0) @db.Decimal(18, 3)
  balanceAfter      Decimal      @db.Decimal(18, 3)

  documentType      String       // MANUAL / MATERIAL_REQUEST — لاحقاً STOCK_IN_DOC / PURCHASE / ...
  documentId        String?
  referenceType     String?
  referenceId       String?
  notes             String?
  performedByUserId String
  createdAt         DateTime     @default(now())

  @@index([itemId, warehouseId, createdAt])
  @@index([documentType, documentId])
  @@map("stock_movements")
  @@schema("warehouse")
}

// ── طلب المواد → الاعتماد (يحجز فوراً) → الصرف ──────────────────────────────

enum MaterialRequestStatus {
  SUBMITTED           // بانتظار مسؤول المستودع
  APPROVED            // اعتماد كامل — تم حجز كامل الكمية المطلوبة
  PARTIALLY_APPROVED  // اعتماد جزئي — الكمية المتاحة أقل من المطلوبة
  REJECTED
  PARTIALLY_ISSUED
  ISSUED              // صُرف كل ما تم اعتماده
  CANCELLED

  @@schema("warehouse")
}

model MaterialRequest {
  id                String                @id @default(uuid())
  documentNo        String                @unique
  warehouseId       String
  warehouse         Warehouse             @relation(fields: [warehouseId], references: [id])
  status            MaterialRequestStatus @default(SUBMITTED)
  referenceType     String                @default("MANUAL") // PROSTHETICS_CASE / DEPARTMENT / MANUAL ...
  referenceId       String?
  departmentId      String?               // users.departments.id — مرجع خارجي بلا FK
  requestedByUserId String
  notes             String?
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  items MaterialRequestItem[]

  @@index([status])
  @@index([referenceType, referenceId])
  @@index([requestedByUserId])
  @@map("material_requests")
  @@schema("warehouse")
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id])
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])

  requestedQty Decimal @db.Decimal(18, 3)
  approvedQty  Decimal @default(0) @db.Decimal(18, 3)
  issuedQty    Decimal @default(0) @db.Decimal(18, 3)

  @@index([materialRequestId])
  @@map("material_request_items")
  @@schema("warehouse")
}
