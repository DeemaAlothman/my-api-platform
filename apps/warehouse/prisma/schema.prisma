generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["warehouse"]
}

// جدول شاهد فقط لإثبات أن الاتصال بقاعدة البيانات والـ migrations يعملان — لا معنى تشغيلياً له
model WarehouseMeta {
  id        Int      @id @default(autoincrement())
  note      String
  createdAt DateTime @default(now())

  @@map("warehouse_meta")
  @@schema("warehouse")
}

// ── بيانات أساسية (Master Data) — بدون أي منطق أرصدة أو حركات بعد ──────────

enum WarehouseType {
  MAIN
  QUARANTINE
  OTHER

  @@schema("warehouse")
}

model Warehouse {
  id                String        @id @default(uuid())
  code              String        @unique
  name              String
  type              WarehouseType @default(MAIN)
  location          String?
  isActive          Boolean       @default(true)
  managerEmployeeId String?       // users.employees.id — مرجع خارجي بلا FK
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  balances         StockBalance[]
  movements        StockMovement[]
  materialRequests MaterialRequest[]
  purchaseInvoices PurchaseInvoice[]
  transfersFrom    StockTransfer[]   @relation("TransfersFrom")
  transfersTo      StockTransfer[]   @relation("TransfersTo")
  returns          Return[]
  returnItemsPosted ReturnItem[]     @relation("ReturnItemPostedWarehouse")
  itemSettings     ItemWarehouseSetting[]
  inventoryCounts  InventoryCount[]

  @@map("warehouses")
  @@schema("warehouse")
}

model Unit {
  id     String  @id @default(uuid())
  name   String
  symbol String?
  items  Item[]

  @@map("units")
  @@schema("warehouse")
}

model ItemCategory {
  id       String         @id @default(uuid())
  name     String
  nameAr   String?
  parentId String?
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  isActive Boolean        @default(true)
  items    Item[]

  @@map("item_categories")
  @@schema("warehouse")
}

model Supplier {
  id       String  @id @default(uuid())
  name     String
  phone    String?
  email    String?
  address  String?
  isActive Boolean @default(true)

  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
  @@schema("warehouse")
}

// ── العملات وأسعار الصرف — عملة الأساس ديناميكية (قابلة للتغيير من الإدارة) ──

model Currency {
  id              String  @id @default(uuid())
  code            String  @unique // USD, SYP, ...
  name            String
  isBaseCurrency  Boolean @default(false)

  exchangeRates    ExchangeRate[]
  purchaseInvoices PurchaseInvoice[]

  @@map("currencies")
  @@schema("warehouse")
}

// سجل تاريخي لأسعار الصرف — rate = كم تساوي وحدة واحدة من هالعملة بعملة الأساس
model ExchangeRate {
  id             String   @id @default(uuid())
  currencyId     String
  currency       Currency @relation(fields: [currencyId], references: [id])
  rate           Decimal  @db.Decimal(18, 8)
  effectiveFrom  DateTime @default(now())
  enteredByUserId String
  createdAt      DateTime @default(now())

  @@index([currencyId, effectiveFrom])
  @@map("exchange_rates")
  @@schema("warehouse")
}

enum ItemType {
  COMPONENT
  CONSUMABLE
  SERVICE

  @@schema("warehouse")
}

// طريقة عرض تكلفة الوحدة لهذا الصنف بالتقارير — قابلة للاختيار لكل صنف لحاله
enum CostingMethod {
  HIGHEST_PRICE
  LAST_PRICE
  AVERAGE_PRICE

  @@schema("warehouse")
}

model Item {
  id           String        @id @default(uuid())
  sku          String        @unique
  partCode     String?       @unique // مفتاح الربط مع مكوّنات الأطراف الصناعية (partCode)
  barcode      String?
  name         String
  nameAr       String?
  itemType     ItemType      @default(CONSUMABLE)
  categoryId   String?
  category     ItemCategory? @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id])
  manufacturer String?
  minStock     Decimal?      @db.Decimal(18, 3)
  costingMethod CostingMethod @default(AVERAGE_PRICE)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  balances             StockBalance[]
  movements            StockMovement[]
  materialRequestItems MaterialRequestItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  stockTransferItems   StockTransferItem[]
  returnItems          ReturnItem[]
  warehouseSettings    ItemWarehouseSetting[]
  inventoryCountItems  InventoryCountItem[]

  @@index([categoryId])
  @@index([unitId])
  @@map("items")
  @@schema("warehouse")
}

// ── الأرصدة والحركات — بدون أي مستند شراء/بيع بعد، إدخال/إخراج يدوي فقط ────

model StockBalance {
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])

  onHandQty      Decimal  @default(0) @db.Decimal(18, 3)
  reservedQty    Decimal  @default(0) @db.Decimal(18, 3)
  avgUnitCost    Decimal? @db.Decimal(18, 4) // متوسط مرجّح — يُحدَّث بكل ترحيل شراء
  lastUnitCost   Decimal? @db.Decimal(18, 4) // آخر سعر شراء تم ترحيله
  highestUnitCost Decimal? @db.Decimal(18, 4) // أعلى سعر شراء وُصِل له
  updatedAt      DateTime @updatedAt

  @@id([warehouseId, itemId])
  @@map("stock_balances")
  @@schema("warehouse")
  // availableQty = onHandQty - reservedQty (يُشتق، لا يُخزَّن)
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  RESERVE       // حجز عند الاعتماد — لا يغيّر onHand، يزيد reserved فقط
  ISSUE         // صرف فعلي لطلب مواد معتمد — ينقص onHand وreserved معاً
  PURCHASE      // ترحيل فاتورة شراء — يزيد onHand ويحدّث تكلفة الوحدة
  TRANSFER_OUT  // خروج من المستودع المصدر بالنقل
  TRANSFER_IN   // دخول للمستودع الهدف بالنقل
  RETURN_OUT    // مرتجع مشتريات — خروج للمورّد
  RETURN_IN     // مرتجع وارد (مبيعات/صرف/تصنيع) — لمستودع عادي أو مستودع التالف حسب الفحص

  @@schema("warehouse")
}

// حركة غير قابلة للتعديل — لا updatedAt عمداً
model StockMovement {
  id                String       @id @default(uuid())
  itemId            String
  item              Item         @relation(fields: [itemId], references: [id])
  warehouseId       String
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id])

  movementType      MovementType
  onHandDelta       Decimal      @default(0) @db.Decimal(18, 3)
  reservedDelta     Decimal      @default(0) @db.Decimal(18, 3)
  balanceAfter      Decimal      @db.Decimal(18, 3)

  documentType      String       // MANUAL / MATERIAL_REQUEST — لاحقاً STOCK_IN_DOC / PURCHASE / ...
  documentId        String?
  referenceType     String?
  referenceId       String?
  notes             String?
  performedByUserId String
  createdAt         DateTime     @default(now())

  @@index([itemId, warehouseId, createdAt])
  @@index([documentType, documentId])
  @@map("stock_movements")
  @@schema("warehouse")
}

// ── طلب المواد → الاعتماد (يحجز فوراً) → الصرف ──────────────────────────────

enum MaterialRequestStatus {
  SUBMITTED           // بانتظار مسؤول المستودع
  APPROVED            // اعتماد كامل — تم حجز كامل الكمية المطلوبة
  PARTIALLY_APPROVED  // اعتماد جزئي — الكمية المتاحة أقل من المطلوبة
  REJECTED
  PARTIALLY_ISSUED
  ISSUED              // صُرف كل ما تم اعتماده
  CANCELLED

  @@schema("warehouse")
}

model MaterialRequest {
  id                String                @id @default(uuid())
  documentNo        String                @unique
  warehouseId       String
  warehouse         Warehouse             @relation(fields: [warehouseId], references: [id])
  status            MaterialRequestStatus @default(SUBMITTED)
  referenceType     String                @default("MANUAL") // PROSTHETICS_CASE / DEPARTMENT / MANUAL ...
  referenceId       String?
  departmentId      String?               // users.departments.id — مرجع خارجي بلا FK
  requestedByUserId String
  notes             String?
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  items MaterialRequestItem[]

  @@index([status])
  @@index([referenceType, referenceId])
  @@index([requestedByUserId])
  @@map("material_requests")
  @@schema("warehouse")
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id])
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])

  requestedQty Decimal @db.Decimal(18, 3)
  approvedQty  Decimal @default(0) @db.Decimal(18, 3)
  issuedQty    Decimal @default(0) @db.Decimal(18, 3)

  @@index([materialRequestId])
  @@map("material_request_items")
  @@schema("warehouse")
}

// ── الشراء — اعتماد مالي ثم ترحيل مخزني، مرحلتان منفصلتان ───────────────────

enum PurchaseInvoiceStatus {
  DRAFT
  APPROVED  // اعتماد مالي فقط — لسا ما أثّر على المخزون
  POSTED    // تم الترحيل — زاد الرصيد فعلياً
  REJECTED
  CANCELLED

  @@schema("warehouse")
}

enum DiscountType {
  PERCENT
  FIXED

  @@schema("warehouse")
}

model PurchaseInvoice {
  id             String                @id @default(uuid())
  documentNo     String                @unique
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  warehouseId    String
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  currencyId     String
  currency       Currency              @relation(fields: [currencyId], references: [id])
  exchangeRate   Decimal               @db.Decimal(18, 8) // نسخة مجمَّدة وقت الإنشاء — لا تتغيّر لاحقاً حتى لو تغيّر السعر المركزي
  invoiceDate    DateTime              @default(now())
  discountType   DiscountType?
  discountValue  Decimal?              @db.Decimal(18, 4)
  subtotal       Decimal               @db.Decimal(18, 4) // بعملة الفاتورة
  total          Decimal               @db.Decimal(18, 4) // بعملة الفاتورة، بعد الخصم
  status         PurchaseInvoiceStatus @default(DRAFT)
  notes          String?
  rejectionReason String?

  createdByUserId String
  approvedByUserId String?
  approvedAt       DateTime?
  postedByUserId   String?
  postedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PurchaseInvoiceItem[]
  returns Return[]

  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("purchase_invoices")
  @@schema("warehouse")
}

model PurchaseInvoiceItem {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])

  qty           Decimal @db.Decimal(18, 3)
  unitPrice     Decimal @db.Decimal(18, 4) // بعملة الفاتورة
  baseUnitPrice Decimal @db.Decimal(18, 4) // = unitPrice × exchangeRate — بعملة الأساس، لتحديث تكلفة المخزون
  lineTotal     Decimal @db.Decimal(18, 4) // بعملة الفاتورة

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_items")
  @@schema("warehouse")
}

// ── النقل بين المستودعات ─────────────────────────────────────────────────
// نفس أمين المستودع بالطرفين → ينفَّذ مباشرة (COMPLETED فوراً).
// أمينان مختلفان → IN_TRANSIT بعد الإرسال، وينتظر تأكيد استلام صريح.

enum StockTransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED

  @@schema("warehouse")
}

model StockTransfer {
  id                String              @id @default(uuid())
  documentNo        String              @unique
  fromWarehouseId   String
  fromWarehouse     Warehouse           @relation("TransfersFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId     String
  toWarehouse       Warehouse           @relation("TransfersTo", fields: [toWarehouseId], references: [id])
  status            StockTransferStatus @default(IN_TRANSIT)
  requestedByUserId String
  notes             String?

  sentAt            DateTime?
  receivedByUserId  String?
  receivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockTransferItem[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
  @@schema("warehouse")
}

model StockTransferItem {
  id              String        @id @default(uuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id])
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])

  requestedQty Decimal  @db.Decimal(18, 3)
  sentQty      Decimal? @db.Decimal(18, 3)
  receivedQty  Decimal? @db.Decimal(18, 3)

  @@index([stockTransferId])
  @@map("stock_transfer_items")
  @@schema("warehouse")
}

// ── المرتجعات (4 أنواع) ──────────────────────────────────────────────────
// مرتجع مشتريات: يخصم من نفس مستودع الفاتورة الأصلية ويقيَّد بالكمية المشتراة فعلياً.
// الثلاثة الباقية (مبيعات/صرف/تصنيع): وارد للمستودع — GOOD يدخل متاحاً فوراً،
// DAMAGED/INSPECT يدخلان مستودع تالف/حجر مستقل (حسب القرار)، ثم يُنقَلان لاحقاً
// بمستند نقل عادي بعد الفحص — بدون تكرار منطق جديد.

enum ReturnType {
  PURCHASE_RETURN
  SALES_RETURN
  ISSUE_RETURN
  PRODUCTION_RETURN

  @@schema("warehouse")
}

enum ReturnCondition {
  GOOD
  DAMAGED
  INSPECT

  @@schema("warehouse")
}

model Return {
  id                String           @id @default(uuid())
  documentNo        String           @unique
  returnType        ReturnType
  warehouseId       String           // المستودع الأصلي المعني (مصدر لمرتجع الشراء، أو المقصود لباقي الأنواع)
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])
  purchaseInvoiceId String?          // إلزامي فعلياً لمرتجع الشراء (يُتحقَّق بالخدمة)
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  sourceReferenceType String?  // SALES_INVOICE / PROSTHETICS_CASE / DEPARTMENT / MANUAL ...
  sourceReferenceId   String?
  departmentId        String?
  createdByUserId     String
  notes               String?
  createdAt           DateTime @default(now())

  items ReturnItem[]

  @@index([returnType])
  @@index([warehouseId])
  @@index([sourceReferenceType, sourceReferenceId])
  @@map("returns")
  @@schema("warehouse")
}

model ReturnItem {
  id       String  @id @default(uuid())
  returnId String
  return   Return  @relation(fields: [returnId], references: [id])
  itemId   String
  item     Item    @relation(fields: [itemId], references: [id])

  qty               Decimal         @db.Decimal(18, 3)
  condition         ReturnCondition @default(GOOD) // يُستعمل فقط لغير مرتجع الشراء
  postedWarehouseId String          // المستودع الفعلي يلي دخلت/خرجت منه الكمية فعلياً (بعد توجيه الفحص)
  postedWarehouse   Warehouse       @relation("ReturnItemPostedWarehouse", fields: [postedWarehouseId], references: [id])
  unitPrice         Decimal?        @db.Decimal(18, 4) // لمرتجع الشراء فقط (بعملة الفاتورة الأصلية)
  note              String?

  @@index([returnId])
  @@map("return_items")
  @@schema("warehouse")
}

// ── حد أدنى لكل مادة داخل كل مستودع لحاله — يتجاوز items.minStock العام عند وجوده ──

model ItemWarehouseSetting {
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  minStock    Decimal   @db.Decimal(18, 3)
  updatedAt   DateTime  @updatedAt

  @@id([itemId, warehouseId])
  @@map("item_warehouse_settings")
  @@schema("warehouse")
}

// ── الجرد — يجمّد المستودع مؤقتاً أثناء الجلسة (يُتحقَّق منه بكل عمليات المخزون الأخرى) ──

enum InventoryCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("warehouse")
}

model InventoryCount {
  id              String               @id @default(uuid())
  documentNo      String               @unique
  warehouseId     String
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  status          InventoryCountStatus @default(IN_PROGRESS)
  startedByUserId String
  startedAt       DateTime             @default(now())
  completedByUserId String?
  completedAt       DateTime?
  notes             String?

  items InventoryCountItem[]

  @@index([warehouseId])
  @@index([status])
  @@map("inventory_counts")
  @@schema("warehouse")
}

model InventoryCountItem {
  id               String         @id @default(uuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id])
  itemId           String
  item             Item           @relation(fields: [itemId], references: [id])

  systemQty     Decimal  @db.Decimal(18, 3) // لقطة الرصيد لحظة بدء الجرد
  actualQty     Decimal? @db.Decimal(18, 3) // يُدخلها الموظف أثناء العدّ الفعلي
  differenceQty Decimal? @db.Decimal(18, 3) // actualQty - systemQty، يُحسب عند التسجيل
  note          String?

  @@index([inventoryCountId])
  @@map("inventory_count_items")
  @@schema("warehouse")
}
