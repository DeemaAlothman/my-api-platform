generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["clinic_orthotics"]
}

// استقبال قسم المقومات — سجل واحد لكل مريض يُعبَّى تدريجياً من 3 أدوار:
// طبيب العظمية، أخصائي العلاج الفيزيائي، أخصائي الأطراف الصناعية.
model OrthoticsReception {
  id        String @id @default(uuid())
  patientId String

  // معلومات ولي الأمر / المرافق (في حال الأطفال)
  guardianName     String?
  guardianRelation String?
  guardianPhone    String?

  // ── تقييم طبيب العظمية ──────────────────────────────────────────────
  // diagnosisTypes: POLIO | CEREBRAL_PALSY | SPINA_BIFIDA | FOOT_DROP | OTHER
  diagnosisTypes    String[]
  // cerebralPalsyType: SPASTIC | HYPOTONIC | ATAXIC
  cerebralPalsyType String?
  footDropCause     String?
  diagnosisOther    String?
  injuryStartDate   String?
  surgicalHistory   String?  @db.Text
  familyHistory     String?  @db.Text
  chiefComplaint    String?  @db.Text

  // عدد المقومات (الأجهزة التقويمية) المطلوبة
  appliancesCount   Int?
  // affectedLimbType: UPPER | LOWER
  affectedLimbType  String?
  // affectedSide: RIGHT | LEFT
  affectedSide      String?
  // وصف اختياري عن الطرف السليم
  soundLimbDescription String? @db.Text

  // قصة الولادة / عوامل الخطورة
  birthHistory             String?  @db.Text
  // الاستخدام السابق للأجهزة التقويمية
  previousOrthosisUse      Boolean?
  previousOrthosisDetails  String?  @db.Text
  // التاريخ المرضي / الأدوية (يختلف عن familyHistory — التاريخ العائلي)
  medicalHistory           String?  @db.Text

  // الأهداف الوظيفية — حتى 3 أهداف نصية
  functionalGoals String[]
  // dailyUseSettings: HOME | SCHOOL | SPORTS | OTHER
  dailyUseSettings String[]
  dailyUseOther    String?

  // muscleTone: NORMAL | SPASTIC | HYPOTONIC
  // muscleTone و spasticityLevel محفوظان كما هما — لسا بينعرضوا للحالات القديمة
  muscleTone      String?
  spasticityLevel String?
  // تفصيل المقوية العضلية لكل منطقة وجهة:
  // [{ region: THIGH|LEG|FOOT|WRIST|UPPER_ARM|FOREARM, side: RIGHT|LEFT,
  //    tone?: NORMAL|SPASTIC|HYPOTONIC, spasticityLevel?: string }]
  muscleToneDetails Json?
  // sensation: INTACT | REDUCED | ABSENT — محفوظ كما هو، لسا بينعرض للحالات القديمة
  sensation       String?
  // تفصيل الإحساس لكل منطقة وجهة:
  // [{ region: THIGH|LEG|FOOT|WRIST|UPPER_ARM|FOREARM, side: RIGHT|LEFT,
  //    sensation?: INTACT|REDUCED|ABSENT }]
  sensationDetails Json?
  // قوة العضلات: EXCELLENT | MODERATE | WEAK — الطرف السفلي (فخذ، ساق/قدم)
  // والطرف العلوي (عضد، ساعد)
  thighMuscleStrength   String?
  legFootMuscleStrength String?
  upperArmMuscleStrength String?
  forearmMuscleStrength  String?
  // skinConditions: INTACT | PRESSURE_POINTS | EDEMA
  skinConditions         String[]
  pressurePointsLocation String?

  doctorAssessmentUpdatedAt DateTime?
  doctorAssessmentUpdatedBy String?

  // ── تقييم أخصائي العلاج الفيزيائي ───────────────────────────────────
  // mobilityLevel: INDEPENDENT | WALKS_WITH_AIDS | WHEELCHAIR_USER
  mobilityLevel    String?
  // assistiveDevices: CRUTCHES | WALKER | CANE | NONE
  assistiveDevices String[]
  // gaitProblems: TOE_DRAG | KNEE_INSTABILITY | PELVIS_TRUNK_TILT | SCISSORING_GAIT
  gaitProblems     String[]

  // hipROM: FREE | LIMITED | DISLOCATED_SUBLUXED
  hipROM   String?
  // kneeROM: NORMAL | FLEXION_CONTRACTURE | VALGUS_VARUS | GENU_RECURVATUM
  kneeROM  String?
  // ankleROM: FREE | EQUINUS | VARUS_VALGUS
  ankleROM String?
  // الطرف العلوي — wristROM / elbowROM: FREE | LIMITED
  wristROM String?
  elbowROM String?

  // muscleStrengthMovements — الطرف السفلي: HIP_FLEXION | HIP_EXTENSION | HIP_ABDUCTION |
  // HIP_ADDUCTION | KNEE_FLEXION | KNEE_EXTENSION | ANKLE_DORSIFLEXION |
  // ANKLE_PLANTARFLEXION | ANKLE_EVERSION | ANKLE_INVERSION | GREAT_TOE_FLEXION
  // والطرف العلوي: ELBOW_FLEXION | ELBOW_EXTENSION | FOREARM_PRONATION |
  // FOREARM_SUPINATION | WRIST_FLEXION | WRIST_EXTENSION
  muscleStrengthMovements String[]
  // درجة قوة كل حركة: { "<حركة من muscleStrengthMovements>": رقم >= 0 }
  muscleStrengthGrades    Json?
  // deformityFlexibility: FLEXIBLE | RIGID
  deformityFlexibility    String?
  // deformityStatus: ACTIVE | DORMANT
  deformityStatus         String?

  // trunkStrengthMovements: TRUNK_FLEXION | TRUNK_EXTENSION | RIGHT_LATERAL_TILT |
  // LEFT_LATERAL_TILT | ROTATION_RIGHT | ROTATION_LEFT
  trunkStrengthMovements String[]
  // درجة قوة كل حركة جذعية: { "<حركة من trunkStrengthMovements>": رقم >= 0 }
  trunkStrengthGrades    Json?
  // trunk*: GOOD | MODERATE | WEAK | ABSENT
  trunkControlSitting         String?
  trunkBalanceDynamicSitting  String?
  trunkControlStanding        String?
  trunkBalanceStaticStanding  String?
  trunkBalanceDynamicStanding String?

  // activityLevel: K0 | K1 | K2 | K3 | K4
  activityLevel String?

  physioAssessmentUpdatedAt DateTime?
  physioAssessmentUpdatedBy String?

  // ── تقييم الجهاز والتوصيات (أخصائي الأطراف الصناعية) ──────────────────
  // recommendedDeviceTypes: AFO | KAFO | ORTHOSIS_WITH_FES | OTHER
  recommendedDeviceTypes String[]
  recommendedDeviceOther String?
  dailyWearHours         Float?
  additionalNotes        String? @db.Text
  // عدّاد مرات استخدام كل نوع جهاز بهاد الاستقبال — { "AFO": 2, "KAFO": 1 }، يزيد تلقائياً
  // بكل حفظ يتضمن النوع، محصور بهاد الاستقبال فقط
  deviceUsageCounts Json @default("{}")

  // ── الرأي النهائي لكل اختصاصي ────────────────────────────────────────
  doctorOpinion      String? @db.Text
  physioOpinion      String? @db.Text
  prosthetistOpinion String? @db.Text

  // المعالجون المسؤولون عن الحالة (employeeId) — يُرسل إشعار لكل معالج يُضاف حديثاً
  practitionerIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  attachments       OrthoticsAttachment[]
  measurementSheets OrthoticsMeasurementSheet[]

  @@index([patientId])
  @@map("orthotics_receptions")
  @@schema("clinic_orthotics")
}

model OrthoticsAttachment {
  id          String   @id @default(uuid())
  receptionId String
  reception   OrthoticsReception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  fileUrl  String
  fileName String
  fileSize Int
  mimeType String

  uploadedAt DateTime @default(now())
  uploadedBy String

  @@index([receptionId])
  @@map("orthotics_attachments")
  @@schema("clinic_orthotics")
}

// أوراق قياس المقومات — سجل لا يُعدَّل ولا يُحذف، كل حفظة = ورقة جديدة.
// sheet يحدد أي رسمة (نموذج) استُخدمت، لأن أسماء الخانات بـ values تتكرر بين النماذج بمعنى مختلف.
model OrthoticsMeasurementSheet {
  id          String             @id @default(uuid())
  receptionId String
  reception   OrthoticsReception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  // sheet: BELOW_KNEE | FULL_LEG | FOOT_ACCESSORIES
  sheet  String
  // side: RIGHT | LEFT
  side   String
  notes  String? @db.Text
  // قيم الخانات كما كُتبت بالرسمة — المفتاح اسم الخانة (مثل circ_01، len_03)، القيمة نص بدون تحويل
  values Json

  examinedAt DateTime @default(now())
  createdBy  String

  @@index([receptionId])
  @@map("orthotics_measurement_sheets")
  @@schema("clinic_orthotics")
}
