generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["clinic_podiatry"]
}

model PodiatryReception {
  id        String   @id @default(uuid())
  patientId String

  // حقول إضافية في الاستقبال
  height     Float?
  weight     Float?
  occupation String?
  activities String?

  // الشكوى الرئيسية
  problemDescription String?  @db.Text
  historyOfSymptoms  String?  @db.Text
  affectedSide       String[]

  // أعراض القدم - متعدد
  footSymptoms String[]

  // نوع الزيارة - متعدد
  visitTypes String[]

  // الأدوية والتشخيصات
  currentMedications        String?  @db.Text
  previousDiagnoses         String?  @db.Text
  herbalPreparations        Boolean?
  herbalPreparationsDetails String?  @db.Text
  otherHealthProblems       String?  @db.Text
  doctorRestrictions        String?  @db.Text

  // التدخين
  smoker           Boolean?
  everSmoked       Boolean?
  smokingFrequency String?

  // مؤشرات صحية
  hasPacemaker      Boolean?
  isPregnant        Boolean?
  allergyToAdhesives Boolean?

  // العمليات الجراحية [ { surgeryName, type, date } ]
  surgeries Json @default("[]")

  // العلاج الفيزيائي
  hadPhysicalTherapy Boolean?
  hasOtherTreatments Boolean?

  // التصوير الشعاعي
  radiographyTypes   String[]
  radiographyOther   String?
  radiographyResults String?  @db.Text

  // التحليلات
  hasNewAnalysis  Boolean?
  newAnalysisDate String?
  hasOldAnalysis  Boolean?
  oldAnalysisDate String?

  // قياس كثافة العظام والمستشفى
  boneDensityScan      Boolean?
  hospitalizedPastYear Boolean?

  // التاريخ المرضي - قائمة الأمراض
  medicalHistory      String[]
  medicalHistoryOther String?

  // شدة الألم
  vasScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  sessions PodiatrySession[]

  @@map("podiatry_receptions")
  @@schema("clinic_podiatry")
}

model PodiatrySession {
  id          String   @id @default(uuid())
  receptionId String
  patientId   String
  sessionDate DateTime @default(now())

  // الخطة العلاجية - متعدد
  clinicalPlan String[]

  // تحليل FootBalance - القدم اليمنى
  rightFlatFoot      Boolean @default(false)
  rightHighArch      Boolean @default(false)
  rightPronation     Boolean @default(false)
  rightSupination    Boolean @default(false)
  rightPressureNotes String?
  rightAsymmetry     String?

  // تحليل FootBalance - القدم اليسرى
  leftFlatFoot      Boolean @default(false)
  leftHighArch      Boolean @default(false)
  leftPronation     Boolean @default(false)
  leftSupination    Boolean @default(false)
  leftPressureNotes String?
  leftAsymmetry     String?

  // التوقيع
  clinicianName      String?
  clinicianSignature String? @db.Text

  archivedAt DateTime?
  archivedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  reception PodiatryReception @relation(fields: [receptionId], references: [id])

  @@map("podiatry_sessions")
  @@schema("clinic_podiatry")
}
