datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["star_of_month"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ── نجم الشهر — مرحلة 1: الدورة الشهرية + القوائم + النقاط التلقائية ─────
// التصويت والمكافآت والتعليقات مراحل لاحقة، بجداول إضافية بمجريشن منفصل لما نوصلها

enum CycleStatus {
  NOMINATING // القائمة انولّدت، بانتظار إضافة مرشح HR وفتح التصويت
  VOTING
  CLOSED

  @@schema("star_of_month")
}

enum CandidateSource {
  AUTO
  HR

  @@schema("star_of_month")
}

enum VoterRole {
  PEER
  MANAGER
  CEO

  @@schema("star_of_month")
}

model Cycle {
  id     String      @id @default(uuid())
  year   Int
  month  Int
  status CycleStatus @default(NOMINATING)

  nominationGeneratedAt DateTime?
  votingOpensAt         DateTime?
  votingClosesAt        DateTime?
  closedAt              DateTime?
  voteReminderSentAt    DateTime? // تذكير "قبل الإغلاق بيوم" — مرة وحدة بس لكل دورة

  candidates Candidate[]
  votes      Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@map("cycles")
  @@schema("star_of_month")
}

model Candidate {
  id         String          @id @default(uuid())
  cycleId    String
  cycle      Cycle           @relation(fields: [cycleId], references: [id])
  company    String          // قيمة حقل company بملف الموظف (VITASYR/VITAXIR) — بلا FK
  employeeId String          // مرجع خارجي لخدمة users — بلا FK
  source     CandidateSource @default(AUTO)

  // النقاط التلقائية — مجمَّدة لحظة توليد القائمة (يوم 1)، فاضية لمرشح HR لحد ما يصوَّت عليه
  latenessScore   Decimal? @db.Decimal(5, 2) // من 10
  leaveScore      Decimal? @db.Decimal(5, 2) // من 10
  substituteScore Decimal? @db.Decimal(5, 2) // من 10
  autoScoreTotal  Decimal? @db.Decimal(5, 2) // من 30

  // القيم الخام (شفافية لعرض التفاصيل لكل معيار)
  lateMinutesTotal Int?
  leaveUnitsTotal  Decimal? @db.Decimal(8, 2)
  substituteCount  Int?

  // نتائج التصويت — تُملأ وتُجمَّد فقط لحظة إغلاق الدورة. ما تظهر بالاستجابة قبل الإغلاق
  peerVoteCount       Int      @default(0)
  peerVoteScore       Decimal? @db.Decimal(5, 2)  // من 40
  managerVoteReceived Boolean  @default(false)
  managerVoteScore    Decimal? @db.Decimal(5, 2)  // 0 أو 10
  ceoVoteReceived     Boolean  @default(false)
  ceoVoteScore        Decimal? @db.Decimal(5, 2)  // 0 أو 20
  finalScore          Decimal? @db.Decimal(6, 2)  // من 100
  isWinner            Boolean  @default(false)
  wasTieBroken        Boolean  @default(false)

  // المكافأة والصورة — تُملأ بعد تحديد الفائز
  imageUrl        String?
  rewardType      String?   // CASH | PAID_LEAVE
  rewardAmount    Decimal?  @db.Decimal(10, 2) // لـCASH (دولار)
  rewardLeaveDays Decimal?  @db.Decimal(5, 2)  // لـPAID_LEAVE
  rewardedAt      DateTime?
  historyRecordedAt DateTime? // لقب "نجم الشهر" انسجّل بإضبارة الموظف — مرة وحدة بس

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, company, employeeId])
  @@index([cycleId, company])
  @@map("candidates")
  @@schema("star_of_month")
}

// نجم الربع — مقارنة الفائزين الشهريين الثلاثة بكل ربع سنة (نفس finalScore يلي فازوا فيه
// شهرياً، بدون إعادة حساب)، والأعلى ياخد شهادة تقدير. لا مكافأة إضافية غير الشهادة
model QuarterWinner {
  id         String  @id @default(uuid())
  year       Int
  quarter    Int // 1-4
  company    String
  employeeId String? // فاضي لحد ما يُحسم التعادل (إن وجد) — مرجع خارجي لخدمة users، بلا FK
  finalScore Decimal @db.Decimal(6, 2) // أعلى finalScore بين الفائزين الثلاثة (أو المتعادلين)

  isTie      Boolean   @default(false)
  resolvedAt DateTime? // لحظة حسم التعادل يدوياً (لو صار تعادل)
  awardedAt  DateTime  @default(now()) // تاريخ ثابت يُطبع بالشهادة — ما يتغيّر بإعادة تحميل الملف

  certificateGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, quarter, company])
  @@map("quarter_winners")
  @@schema("star_of_month")
}

// تعليقات على صورة/بطاقة النجم الفائز — موظف عادي يضيف، HR يحذف أي تعليق
model Comment {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  employeeId  String    // مرجع خارجي لخدمة users — بلا FK
  text        String    @db.Text

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@map("comments")
  @@schema("star_of_month")
}

// صوت واحد — سري، ما يُكشف لمين صوّت لمين لأي حدا غير صاحبه (عبر my-vote فقط)
model Vote {
  id      String @id @default(uuid())
  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id])
  company String

  voterEmployeeId     String // مرجع خارجي لخدمة users — بلا FK
  candidateEmployeeId String // مرجع خارجي لخدمة users — بلا FK
  voterRole           VoterRole

  createdAt DateTime @default(now())

  // صوت واحد بس لكل (موظف، نوع الصوت) بكل قائمة شركة — بيسمح لنفس الشخص ياخد أكتر من
  // دور تصويت (مثلاً زميل عادي وبنفس الوقت مدير إداري) لكن صوت واحد بكل دور
  @@unique([cycleId, company, voterEmployeeId, voterRole])
  @@index([cycleId, company])
  @@map("votes")
  @@schema("star_of_month")
}
