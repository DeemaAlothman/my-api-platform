generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["clinic_physio"]
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum LifeType {
  PROFESSIONAL
  NORMAL
  SEDENTARY
  ABNORMAL
  @@schema("clinic_physio")
}

enum PainLevel {
  MILD
  MODERATE
  SEVERE
  EXCRUCIATING
  @@schema("clinic_physio")
}

enum PainDuration {
  INTERMITTENT
  CONSTANT
  WITH_CERTAIN_MOTIONS
  @@schema("clinic_physio")
}

enum PhysioPainType {
  NUMBNESS
  DULL_ACHE
  HOT_BURNING
  SHARP_STABBING
  PINS
  OTHER
  @@schema("clinic_physio")
}

enum PainFactor {
  SITTING
  HEAT
  COLD
  COUGHING
  WALKING
  EXERCISE
  LYING_DOWN
  OTHER
  @@schema("clinic_physio")
}

enum PhysioStatus {
  INTAKE
  COMPLAINT
  PAIN_MAP
  MEDICAL_HISTORY
  GOALS
  POSTURAL_ASSESSMENT
  TREATMENT_PLAN
  EVALUATION
  SUPERVISOR_REVIEW
  DOCTOR_SIGN
  ACTIVE_TREATMENT
  COMPLETED
  DISCHARGED
  CANCELLED
  @@schema("clinic_physio")
}

enum ChronicCondition {
  AIDS_HIV
  MULTIPLE_SCLEROSIS
  LIVER_PROBLEMS
  ARTHRITIS
  STDS
  PNEUMONIA
  CANCER
  ANGINA
  URINARY_INFECTION
  DIABETES
  BLOOD_CLOTS
  HEMOPHILIA
  CIRCULATION_PROBLEMS
  LUNG_ISSUES
  EYE_INFECTION
  STROKE
  JOINT_BONE_INFECTION
  KIDNEY_PROBLEMS
  MUSCULOSKELETAL
  ANEMIA
  TUBERCULOSIS
  ASTHMA
  ARTERIOSCLEROSIS
  CHEMICAL_DEPENDENCY
  BONE_INFECTION
  EPILEPSY
  DEPRESSION
  HEART_PROBLEMS
  HYPERTENSION
  OTHER
  @@schema("clinic_physio")
}

enum MedicalTest {
  MRI
  XRAY
  CT
  MYELOGRAM
  BONE_DENSITY
  OTHER
  @@schema("clinic_physio")
}

enum PhysioGoal {
  BACK_TO_SPORTS
  BACK_TO_WORK
  SIMPLE_WORKS
  PAIN_RELIEF
  OTHER
  @@schema("clinic_physio")
}

enum TherapyModality {
  ESWT
  US
  TENS
  EMS
  LASER
  CPM
  HOT_PACKS
  COLD_PACKS
  TRACTION
  EXERCISES
  MANUAL_THERAPY
  MASSAGE
  KINESIO_TAPING
  COMPRESSION
  PARAFFIN
  GRASTON
  MET
  PNF
  INFRARED
  OTHER
  @@schema("clinic_physio")
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  @@schema("clinic_physio")
}

// ── Main Case ─────────────────────────────────────────────────────────────

model PhysioCase {
  id                  String   @id @default(uuid())
  caseNumber          String   @unique
  patientId           String

  currentJob          String?
  lifeType            LifeType?

  majorComplaint      String   @db.Text
  symptoms            String   @db.Text
  complaintStartDate  String?   // تاريخ البدء — نص حر
  possibleCause       String?

  previousDoctorSeen  String?
  previousTreatment   String?
  hadPreviousPT       Boolean  @default(false)
  hadPreviousInjury   String?  // هل سبق التعرض لهذه الإصابة؟ (نص حر)

  // ── الشكوى المرضية (Medical Complaint form) ──
  complaintType         String?  // نوع الشكاية المرضية
  painLocation          String?  // تحديد مكان الألم
  complaintDuration     String?  // منذ متى وأنت تعاني (نص حر)
  complaintNotes        String?  @db.Text // ملاحظات
  hasChronicDiseases    Boolean  @default(false) // هل يوجد أمراض مزمنة؟
  chronicDiseasesDetail String?  // ما هو المرض المزمن
  visitedSpecialist     Boolean  @default(false) // هل سبق وزرت طبيباً مختصاً؟
  hadSurgery            Boolean  @default(false)  // هل سبق وخضعت لعمل جراحي؟
  surgeryDetail         String?  // تفاصيل العمل الجراحي

  // ── الملاحظات والتقييم (Notes & Evaluation) — مخزّنة على الحالة مثل الشكوى ──
  evalModalities      TherapyModality[]
  evalOtherModality   String?  // النص عند اختيار "أخرى Other"
  evalNotes           String?  @db.Text // ملاحظات
  evalSummary         String?  @db.Text // التقييم

  painStartDate       DateTime?
  painLevel           PainLevel?
  painDuration        PainDuration?
  painProgression     String?
  bestTimeOfDay       String?
  worstTimeOfDay      String?

  painTypes           PhysioPainType[]
  painTypeOther       String?
  aggravatingFactors  PainFactor[]
  aggravatingOther    String?
  alleviatingFactors  PainFactor[]
  alleviatingOther    String?

  status              PhysioStatus @default(INTAKE)

  physiotherapistId   String?
  supervisingDoctorId String?
  caseManagerId       String?

  treatmentFrom       DateTime?
  treatmentTo         DateTime?
  anticipatedVisits   Int?

  finalNotes          String?  @db.Text
  finalSummary        String?  @db.Text // الملخص النهائي بعد انتهاء كل الجلسات

  painMap             PainMap?
  medicalHistory      MedicalHistory?
  treatmentGoals      TreatmentGoals?
  posturalAssessment  PosturalAssessment?
  treatmentPlan       PhysioTreatmentPlan?
  sessions            PhysioSession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  deletedAt   DateTime?

  @@map("physio_cases")
  @@schema("clinic_physio")
  @@index([patientId])
  @@index([status])
  @@index([caseNumber])
}

// ── Pain Map ──────────────────────────────────────────────────────────────

model PainMap {
  id      String     @id @default(uuid())
  caseId  String     @unique
  case    PhysioCase @relation(fields: [caseId], references: [id])

  regions Json
  notes   String? @db.Text

  @@map("pain_maps")
  @@schema("clinic_physio")
}

// ── Medical History ───────────────────────────────────────────────────────

model MedicalHistory {
  id      String     @id @default(uuid())
  caseId  String     @unique
  case    PhysioCase @relation(fields: [caseId], references: [id])

  smokes              Boolean @default(false)
  hasSmokedBefore     Boolean @default(false)
  smokingFrequency    String?

  hasPacemaker        Boolean @default(false)
  pacemakerDetail     String? // تفاصيل جهاز تنظيم ضربات القلب عند نعم

  allergies           String? @db.Text  // الحساسية (عام)
  adhesiveAllergy     Boolean @default(false) // حساسية لاصق/لاتكس/لسعات نحل
  adhesiveAllergyDetail String? // «إذا نعم يرجى ذكر ما يلي» لسؤال اللاصق

  currentMedications  String? @db.Text
  prescriptionDrugs   Boolean @default(false)
  herbalSupplements   Boolean @default(false)
  supplementsList     String?

  // حقول خاصة بالإناث (تُعرض على الفرونت فقط إذا كان المريض أنثى)
  isPregnant          Boolean @default(false) // هل أنت حامل؟
  maritalStatus       String? // عزباء / متزوجة
  lastMenstrualPeriod String? // تاريخ آخر دورة شهرية (نص)

  previousDiagnoses   String? @db.Text

  chronicConditions   ChronicCondition[]
  otherConditions     String?
  chronicConditionsOther String? // النص عند اختيار "آخر Other" في قائمة الأمراض المزمنة

  // هل تعاني من مشاكل صحية أخرى؟ (التفصيل في otherConditions)
  hasOtherHealthProblems Boolean @default(false)

  doctorRestrictions  String? @db.Text

  surgeries           Surgery[]
  // الشكاوى السابقة / العمليات الجراحية السابقة (نص)
  previousComplaintsSurgeries String? @db.Text

  // هل خضعت لأي عمليات جراحية؟ + التفصيل عند نعم
  hadSurgeries        Boolean @default(false)
  surgeriesDetail     String? @db.Text

  // هل خضعت للعلاج الطبيعي لنفس المشكلة؟ + التفصيل عند نعم
  hadPTSameProblem    Boolean @default(false)
  ptSameProblemDetail String?

  // هل تتلقى علاجات أخرى لهذه المشكلة حالياً؟ التفصيل عند نعم
  otherTreatmentDetail String?

  testsHad            MedicalTest[]
  testsOther          String?
  testResults         String? @db.Text

  newAnalysis         String?
  newAnalysisDate     DateTime?
  newAnalysisAttachment String? // رابط مرفق التحليل الجديد (مستند مريض)
  oldAnalysis         String?
  oldAnalysisDate     DateTime?
  oldAnalysisAttachment String? // رابط مرفق التحليل القديم (مستند مريض)

  // قياس كثافة العظم
  boneDensityTest     Boolean @default(false)
  boneDensityDetail   String?

  hospitalizedLastYear       Boolean @default(false)
  hospitalizedDetail         String? // سبب/تفاصيل دخول المستشفى عند نعم
  receivingOtherTreatment    Boolean @default(false)

  @@map("medical_histories")
  @@schema("clinic_physio")
}

model Surgery {
  id        String         @id @default(uuid())
  historyId String
  history   MedicalHistory @relation(fields: [historyId], references: [id])
  name      String
  date      DateTime?
  type      String?
  order     Int

  @@map("surgeries")
  @@schema("clinic_physio")
  @@index([historyId])
}

// ── Treatment Goals ───────────────────────────────────────────────────────

model TreatmentGoals {
  id      String     @id @default(uuid())
  caseId  String     @unique
  case    PhysioCase @relation(fields: [caseId], references: [id])

  goals             PhysioGoal[]
  customGoal        String?

  decreasePain      Boolean @default(false)
  improveStrength   Boolean @default(false)
  lessDifficultyWork Boolean @default(false)

  standLonger String? // أطول فترة وقوف (وقت HH:MM)
  sleepLonger String? // أطول فترة نوم (وقت HH:MM)
  sitLonger   String? // أطول فترة جلوس (وقت HH:MM)

  improveMovement   Boolean @default(false)
  otherGoals        String? @db.Text

  @@map("treatment_goals")
  @@schema("clinic_physio")
}

// ── Postural Assessment ───────────────────────────────────────────────────

model PosturalAssessment {
  id      String     @id @default(uuid())
  caseId  String     @unique
  case    PhysioCase @relation(fields: [caseId], references: [id])

  seatedPosition  String? @db.Text
  trunkControl    String? @db.Text

  head      Json
  shoulders Json
  elbow     Json
  ribCage   Json
  spine     Json
  pelvis    Json
  hips      Json
  knees     Json
  feet      Json

  spasticityNotes String? @db.Text
  generalNotes    String? @db.Text
  diagnosis       String? @db.Text

  @@map("postural_assessments")
  @@schema("clinic_physio")
}

// ── Treatment Plan ────────────────────────────────────────────────────────

model PhysioTreatmentPlan {
  id      String     @id @default(uuid())
  caseId  String     @unique
  case    PhysioCase @relation(fields: [caseId], references: [id])

  modalities      TherapyModality[]
  otherModality   String?
  remarks         String? @db.Text
  observation     String? @db.Text

  supervisorGaze          String? @db.Text
  supervisorId            String?
  supervisorReviewedAt    DateTime?

  doctorGaze              String? @db.Text
  doctorId                String?
  doctorReviewedAt        DateTime?
  doctorSignatureBase64   String? @db.Text
  doctorSignedAt          DateTime?
  doctorSignatureIp       String?

  status  PlanStatus @default(ACTIVE)

  @@map("physio_treatment_plans")
  @@schema("clinic_physio")
}

// ── Sessions ──────────────────────────────────────────────────────────────

model PhysioSession {
  id      String     @id @default(uuid())
  caseId  String
  case    PhysioCase @relation(fields: [caseId], references: [id])

  sessionNumber   Int?      // رقم الجلسة (تلقائي تسلسلي لكل حالة)
  sessionDate     DateTime
  sessionTime     String?
  modalities      TherapyModality[]
  notes           String? @db.Text

  supervisorOpinion String? @db.Text // رأي رئيس القسم (مطلوب قبل فتح الجلسة التالية)
  doctorDecision    String? @db.Text // قرار الطبيب (نص، بدون توقيع)

  physiotherapistId       String?
  painLevel               Int?
  romMeasurements         Json?
  attendanceConfirmed     Boolean @default(false)
  appointmentId           String?

  @@map("physio_sessions")
  @@schema("clinic_physio")
  @@index([caseId])
  @@index([sessionDate])
}
