generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["clinic_prosthetics"]
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum AmputationCause {
  WAR_INJURY
  TRAFFIC_ACCIDENT
  DIABETES
  VASCULAR_DISEASE
  CONGENITAL
  INFECTION
  TUMOR
  WORK_INJURY
  OTHER
  @@schema("clinic_prosthetics")
}

enum AmputationType {
  UPPER
  LOWER
  @@schema("clinic_prosthetics")
}

enum AmputationSide {
  RIGHT
  LEFT
  BILATERAL
  @@schema("clinic_prosthetics")
}

enum AmputationLevel {
  PH
  WD
  TR
  ED
  TH
  SD
  PF
  CHOPART
  TT
  KD
  TF
  HD
  @@schema("clinic_prosthetics")
}

enum CaseStatus {
  INTAKE
  ASSESSMENT
  COMMITTEE_REVIEW
  APPROVED
  FITTING
  SOCKET_TRIAL
  GAIT_TRAINING
  FINAL_REVIEW
  DELIVERED
  FOLLOW_UP
  CANCELLED
  @@schema("clinic_prosthetics")
}

enum ProsthesisType {
  BIONIC
  MYOBOCK
  MECHANIC
  COSMETIC_COVER
  OTHER
  @@schema("clinic_prosthetics")
}

enum KLevel {
  K0
  K1
  K2
  K3
  K4
  @@schema("clinic_prosthetics")
}

enum CommitteeDecision {
  APPROVED
  NEEDS_ADJUSTMENT
  REJECTED
  @@schema("clinic_prosthetics")
}

enum ComponentSource {
  WAREHOUSE
  SUPPLIER
  @@schema("clinic_prosthetics")
}

enum ResidualLimbLength {
  LONG
  MEDIUM
  SHORT
  VERY_SHORT
  @@schema("clinic_prosthetics")
}

enum ResidualLimbShape {
  BONY
  SOFT
  NORMAL
  CONICAL_BONY
  CONICAL_SOFT
  @@schema("clinic_prosthetics")
}

enum SkinTemperature {
  NORMAL
  HOT
  COLD
  @@schema("clinic_prosthetics")
}

enum PainType {
  NUMBNESS
  DULL_ACHE
  HOT_BURNING
  SHARP_STABBING
  PINS
  OTHER
  @@schema("clinic_prosthetics")
}

enum SkinAppearance {
  NORMAL
  PALE
  DRY
  INFLAMED
  PEELING
  OOZING
  @@schema("clinic_prosthetics")
}

enum SkinColor {
  NORMAL
  PALE
  CYANOTIC
  ERYTHEMATOUS
  YELLOWISH
  @@schema("clinic_prosthetics")
}

// حالة الترقيع الجلدي / منطقة الكسب / الندبة — حسب استمارة التقييم الورقية
enum ScarCondition {
  OPEN
  CLOSED
  FLEXIBLE
  HEALED
  OOZING
  INFLAMED
  DRY
  @@schema("clinic_prosthetics")
}

// جانب التقييم — لازم لكل حالة ثنائية الأطراف (Bilateral): سطر مستقل لكل طرف
enum AssessmentSide {
  LEFT
  RIGHT
  @@schema("clinic_prosthetics")
}

// تقييم مدى حركة المفاصل العام (غير تفصيل كل مفصل بـ romData)
enum JointsCondition {
  NORMAL
  ACTIVE
  SEDENTARY
  @@schema("clinic_prosthetics")
}

enum LoadTolerance {
  NOT_PALPABLE
  PALPABLE
  NON_WEIGHT_BEARING
  WEIGHT_BEARING
  @@schema("clinic_prosthetics")
}

enum WeightBearingLevel {
  FULL
  HIGH
  MEDIUM
  LOW
  @@schema("clinic_prosthetics")
}

enum QualityLevel {
  GOOD
  FAIR
  POOR
  @@schema("clinic_prosthetics")
}

enum IndependenceLevel {
  INDEPENDENT
  ASSISTED
  @@schema("clinic_prosthetics")
}

enum StabilityLevel {
  STABLE
  UNSTABLE
  @@schema("clinic_prosthetics")
}

enum AssistiveDevice {
  NONE
  CANE
  CRUTCHES
  WALKER
  @@schema("clinic_prosthetics")
}

enum FallRiskLevel {
  LOW
  MODERATE
  HIGH
  @@schema("clinic_prosthetics")
}

enum AlignmentStatus {
  GOOD
  NEEDS_ADJUSTMENT
  @@schema("clinic_prosthetics")
}

enum SuspensionSystem {
  PIN
  PASSIVE_VACUUM
  ACTIVE_VACUUM
  DVS
  SOFT_SOCKET
  BELT_STRAP
  OTHER
  @@schema("clinic_prosthetics")
}

enum SocketBearing {
  PTB
  TSB
  MAS
  ISCHIAL_CONTAINMENT
  OTHER
  @@schema("clinic_prosthetics")
}

enum KneeJointType {
  MECHANICAL
  HYDRAULIC
  POLYCENTRIC
  MONOCENTRIC
  MKP
  OTHER
  @@schema("clinic_prosthetics")
}

enum FootType {
  DYNAMIC
  HYDRAULIC
  SACH
  CARBON
  SINGLE_AXIS
  MULTI_AXIS
  OTHER
  @@schema("clinic_prosthetics")
}

// ── Main Case ─────────────────────────────────────────────────────────────

model ProstheticsCase {
  id              String   @id @default(uuid())
  caseNumber      String   @unique
  patientId       String

  amputationDate  DateTime?
  amputationCause AmputationCause?
  // يُعبّى فقط إذا amputationCause = OTHER
  amputationCauseOtherDetail String?
  amputationCount Int      @default(1)
  amputationType  AmputationType[] @default([])
  amputationSide  AmputationSide?
  amputationLevel AmputationLevel[] @default([])
  // الجانب الأكثر تأثراً والذي يجري رصده وعلاجه — فقط عند amputationSide = BILATERAL
  moreAffectedSide AmputationSide?

  status              CaseStatus @default(INTAKE)
  hasPreviousProsthesis Boolean @default(false)
  previousProsthesisDetails String?
  previousProsthesisWhen    String?
  previousProsthesisWhere   String?
  previousProsthesisType    String?
  hasRevisionSurgery  Boolean @default(false)
  revisionDetails     String?
  hasPhysicalTherapy  Boolean @default(false)
  physicalTherapyDetails String?
  hasChronicDiseases  Boolean @default(false)
  chronicDiseases     String?

  // من استمارة التقييم السريري (علوي/سفلي) — سؤال واحد للحالة، لا يتكرر حسب الطرف
  currentlyUsingProsthesis       Boolean?
  previouslyUsedProsthesis       Boolean?
  previousProsthesisSystemDetail String?

  prosthetistId        String?
  physiotherapistId    String?
  supervisingDoctorId  String?
  workshopSupervisorId String?

  prosthesisType         ProsthesisType?
  prosthesisSuitable     Boolean?
  proposedProsthesisType String?
  // الطرف الصناعي مكتمل التجميع (من فورم أجزاء ومكونات الطرف)
  prosthesisCompleted    Boolean @default(false)

  upperAssessment                UpperLimbAssessment[]
  lowerAssessment                LowerLimbAssessment[]
  ankleDisarticulationAssessment AnkleDisarticulationAssessment[]
  kneeDisarticulationAssessment  KneeDisarticulationAssessment[]
  transfemoralAssessment         TransfemoralAssessment[]
  transtibialAssessment          TranstibialAssessment[]
  hemipelvectomyAssessment       HemipelvectomyAssessment[]
  transradialAssessment          TransradialAssessment[]
  elbowDisarticulationAssessment ElbowDisarticulationAssessment[]
  transhumeralAssessment         TranshumeralAssessment[]
  committeeReview                CommitteeReview?
  components       ProsthesisComponent[]
  gaitAnalysis     GaitAnalysis?
  balanceAssessment BalanceAssessment?
  treatmentPlan    TreatmentPlan?
  consumables      ConsumableUsage[]
  finalEvaluation  FinalEvaluation?
  delivery         Delivery?
  followUps          FollowUp[]
  attachments        CaseAttachment[]
  reviewPrograms     PatientReviewProgram[]
  prostheticDelivery   ProstheticDeliveryForm?
  balanceAssessmentForms BalanceAssessmentForm[]
  gaitAnalysisForms  GaitAnalysisForm[]
  treatmentPrograms  CaseTreatmentProgram[]
  alerts             CaseAlert[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  deletedAt   DateTime?

  @@map("prosthetics_cases")
  @@schema("clinic_prosthetics")
  @@index([patientId])
  @@index([status])
  @@index([caseNumber])
}

model CaseAlert {
  id           String          @id @default(uuid())
  caseId       String
  case         ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  note         String          @db.Text
  sentAt       DateTime        @default(now())
  sentByUserId String
  responseNote String?         @db.Text
  respondedAt  DateTime?

  @@index([caseId])
  @@map("case_alerts")
  @@schema("clinic_prosthetics")
}

// ── Assessments ───────────────────────────────────────────────────────────

model UpperLimbAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  residualLimbLength  ResidualLimbLength?
  residualLimbShape   ResidualLimbShape?
  residualLimbPhotoUrl String?

  painPresent          Boolean @default(false)
  painArea             String?
  painIntensity        Int?
  painTypes            PainType[]
  painTypeOtherDetail  String?
  phantomPainPresent   Boolean @default(false)
  phantomPainIntensity Int?
  residualLimbPalpable Boolean?
  neuromaPalpable      Boolean?

  skinAppearance      SkinAppearance[]
  skinNotes           String? @db.Text
  skinColor           SkinColor[]
  skinTemperature     SkinTemperature?
  scarCondition       ScarCondition[]
  hasSkinGrafts       Boolean @default(false)
  graftArea           String?

  hasOtherAffectedLimbs          Boolean?
  canBalanceOneSide              Boolean?
  usesCompressionBandage         Boolean?
  jointsRangeOfMotion            JointsCondition?
  activityLevel                  KLevel?

  romData            Json?
  muscleMotionNotes  String? @db.Text

  neuromaPresent       Boolean?
  usesProstheticLimb   Boolean?
  prostheticLimbType   String?

  // ممكن أكثر من شخص بكل دور
  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("upper_limb_assessments")
  @@schema("clinic_prosthetics")
}

model LowerLimbAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  residualLimbLength   ResidualLimbLength?
  residualLimbShape    ResidualLimbShape?
  residualLimbPhotoUrl String?
  // ملاحظة حول مستوى البتر
  amputationLevelNote  String? @db.Text

  painPresent          Boolean @default(false)
  painArea             String?
  painIntensity        Int?
  painTypes            PainType[]
  painTypeOtherDetail  String?
  phantomPainPresent   Boolean @default(false)
  phantomPainIntensity Int?
  neuromaPalpable      Boolean?

  loadTolerance      LoadTolerance?
  // يُعبّى فقط إذا loadTolerance = WEIGHT_BEARING
  weightBearingLevel WeightBearingLevel?
  notes              String? @db.Text

  skinAppearance      SkinAppearance[]
  skinColor           SkinColor[]
  skinTemperature     SkinTemperature?
  scarCondition       ScarCondition[]
  hasSkinGrafts       Boolean @default(false)
  graftArea           String?

  otherLimbCondition   String?
  usesAssistiveDevices Boolean @default(false)
  assistiveDeviceTypes String?
  canClimbStairs       Boolean?
  canBalanceOneSide    Boolean?
  jointsRangeOfMotion  JointsCondition?
  activityLevel        KLevel?

  romData            Json?
  muscleMotionNotes  String? @db.Text

  usesProstheticLimb   Boolean?
  prostheticLimbType   String?

  // ممكن أكثر من شخص بكل دور
  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("lower_limb_assessments")
  @@schema("clinic_prosthetics")
}

// ── Ankle Disarticulation Assessment (AD) ────────────────────────────────

model AnkleDisarticulationAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes           String? @db.Text
  footMeasurement String?

  // مصفوفة طرف سليم — مفاتيح 1-5 مع قيمة لكل منها (nullable)
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-19 مع قيمة لكل منها (nullable)
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("ankle_disarticulation_assessments")
  @@schema("clinic_prosthetics")
}

// ── Transhumeral Assessment (TH - بتر علوي فوق المرفق) ──────────────────

model TranshumeralAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes        String? @db.Text

  // مصفوفة طرف سليم — مفاتيح 1-10
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-6
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("transhumeral_assessments")
  @@schema("clinic_prosthetics")
}

// ── Elbow Disarticulation Assessment (ED - بتر علوي عبر المرفق) ──────────

model ElbowDisarticulationAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes        String? @db.Text

  // مصفوفة طرف سليم — مفاتيح 1-12
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-9
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("elbow_disarticulation_assessments")
  @@schema("clinic_prosthetics")
}

// ── Transradial Assessment (TR - بتر علوي تحت المرفق) ───────────────────

model TransradialAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes        String? @db.Text

  // مصفوفة طرف سليم — مفاتيح 1-7
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-10
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("transradial_assessments")
  @@schema("clinic_prosthetics")
}

// ── Hemipelvectomy Assessment (HP - بتر سفلي عبر الحوض) ─────────────────

model HemipelvectomyAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes           String? @db.Text
  footMeasurement String?

  // مصفوفة طرف سليم — مفاتيح 1-15
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفتاح 1 فقط
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("hemipelvectomy_assessments")
  @@schema("clinic_prosthetics")
}

// ── Transtibial Assessment (TT - بتر سفلي تحت الركبة) ───────────────────

model TranstibialAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes           String? @db.Text
  footMeasurement String?

  // مصفوفة طرف سليم — مفاتيح 1-5
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-19
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("transtibial_assessments")
  @@schema("clinic_prosthetics")
}

// ── Transfemoral Assessment (TF - بتر سفلي فوق الركبة) ──────────────────

model TransfemoralAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes           String? @db.Text
  footMeasurement String?

  // مصفوفة طرف سليم — مفاتيح 1-11
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-12
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("transfemoral_assessments")
  @@schema("clinic_prosthetics")
}

// ── Knee Disarticulation Assessment (KD) ─────────────────────────────────

model KneeDisarticulationAssessment {
  id     String @id @default(uuid())
  caseId String
  side   AssessmentSide
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  notes           String? @db.Text
  footMeasurement String?

  // مصفوفة طرف سليم — مفاتيح 1-5
  soundLimb    Json?
  // مصفوفة طرف مصاب — مفاتيح 1-12
  affectedLimb Json?

  examinerProsthetistIds String[]
  examinerPhysioIds      String[]
  examinerSupervisorIds  String[]
  examinedAt             DateTime @default(now())

  @@index([caseId, side])
  @@map("knee_disarticulation_assessments")
  @@schema("clinic_prosthetics")
}

// ── Committee ─────────────────────────────────────────────────────────────

model CommitteeReview {
  id     String @id @default(uuid())
  caseId String @unique
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  prosthetistOpinion       String? @db.Text
  prosthetistUserId        String?
  prosthetistReviewedAt    DateTime?

  physiotherapistOpinion   String? @db.Text
  physiotherapistUserId    String?
  physiotherapistReviewedAt DateTime?

  doctorOpinion            String? @db.Text
  doctorUserId             String?
  doctorReviewedAt         DateTime?

  committeeHeadOpinion     String? @db.Text
  committeeHeadUserId      String?
  committeeHeadReviewedAt  DateTime?

  expertOpinion            String? @db.Text
  expertUserId             String?
  expertReviewedAt         DateTime?

  finalDecision            CommitteeDecision?
  finalSummary             String? @db.Text
  decidedAt                DateTime?

  doctorSignatureBase64    String? @db.Text
  doctorSignedAt           DateTime?
  doctorSignatureIp        String?

  prosthetistSignatureBase64    String? @db.Text
  prosthetistSignedAt           DateTime?
  prosthetistSignatureIp        String?

  physiotherapistSignatureBase64 String? @db.Text
  physiotherapistSignedAt        DateTime?
  physiotherapistSignatureIp     String?

  @@map("committee_reviews")
  @@schema("clinic_prosthetics")
}

// ── Components ────────────────────────────────────────────────────────────

model ProsthesisComponent {
  id              String @id @default(uuid())
  caseId          String
  case            ProstheticsCase @relation(fields: [caseId], references: [id])

  inventoryItemId String?
  partCode        String
  partName        String
  supplier        String
  sourceLocation  ComponentSource
  reason          String?
  addedAt         DateTime @default(now())
  addedBy         String
  isApproved      Boolean  @default(false)
  approvedAt      DateTime?

  @@map("prosthesis_components")
  @@schema("clinic_prosthetics")
  @@index([caseId])
}

// ── Gait Analysis ─────────────────────────────────────────────────────────

model GaitAnalysis {
  id     String @id @default(uuid())
  caseId String @unique
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  suspensionSystem   SuspensionSystem[]
  socketBearing      SocketBearing?
  kneeJointType      KneeJointType?
  footType           FootType?

  socketPain         Boolean @default(false)
  residualLimbPain   Boolean @default(false)
  painIntensity      Int?
  alignmentCheck     AlignmentStatus?
  hasRomLimitations  Boolean @default(false)

  hasHipFlexionContracture  Boolean @default(false)
  hasKneeFlexionContracture Boolean @default(false)
  weakHipAbductors   Boolean @default(false)
  weakHipExtensors   Boolean @default(false)
  weakTrunkMuscles   Boolean @default(false)
  otherWeakness      String?

  trunkStability     QualityLevel?
  abdominalControl   QualityLevel?
  pelvicControl      QualityLevel?
  sittingBalance     IndependenceLevel?
  standingBalance    StabilityLevel?

  assistiveDevice    AssistiveDevice?
  speedMs            Float?
  cadence            Int?
  stepLengthProsCm   Float?
  stepLengthSoundCm  Float?
  stancePercProsthetic Float?
  stancePercSound    Float?
  symmetry           QualityLevel?

  deviations         Json
  mainProblem        String?

  notes              String? @db.Text
  examinerProsthetistId String
  examinerPhysioId      String
  examinedAt            DateTime @default(now())
  signedByDoctorId      String?
  doctorSignatureBase64 String? @db.Text
  doctorSignedAt        DateTime?

  @@map("gait_analyses")
  @@schema("clinic_prosthetics")
}

// ── Balance Assessment ────────────────────────────────────────────────────

model BalanceAssessment {
  id     String @id @default(uuid())
  caseId String @unique
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  staticResults   Json
  dynamicResults  Json
  activityResults Json

  historyOfFalls  Boolean @default(false)
  nearFalls       Boolean @default(false)
  fearOfFalling   Boolean @default(false)
  fallRiskLevel   FallRiskLevel?
  overallBalanceLevel QualityLevel?

  exerciseProgram   Json
  homeExerciseProgram Boolean @default(false)
  followUpWeeks     Int?

  examinerPhysioId  String
  committeeHeadId   String?
  examinedAt        DateTime @default(now())

  @@map("balance_assessments")
  @@schema("clinic_prosthetics")
}

// ── Treatment Plan & Sessions ─────────────────────────────────────────────

model TreatmentPlan {
  id     String @id @default(uuid())
  caseId String @unique
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  workshopSessions WorkshopSession[]
  ptSessions       PtSession[]
  mediaSessions    MediaSession[]
  notes            String? @db.Text

  @@map("treatment_plans")
  @@schema("clinic_prosthetics")
}

model WorkshopSession {
  id              String @id @default(uuid())
  planId          String
  plan            TreatmentPlan @relation(fields: [planId], references: [id])
  sessionDate     DateTime
  sessionTime     String?
  providedService String @db.Text
  notes           String? @db.Text
  technicianId    String

  treatmentProgram PatientTreatmentProgram?

  @@map("workshop_sessions")
  @@schema("clinic_prosthetics")
}

model PtSession {
  id              String @id @default(uuid())
  planId          String
  plan            TreatmentPlan @relation(fields: [planId], references: [id])
  sessionDate     DateTime
  sessionTime     String?
  providedService String @db.Text
  notes           String? @db.Text
  physiotherapistId String

  treatmentProgram PatientTreatmentProgram?

  @@map("pt_sessions")
  @@schema("clinic_prosthetics")
}

model MediaSession {
  id              String @id @default(uuid())
  planId          String
  plan            TreatmentPlan @relation(fields: [planId], references: [id])
  sessionDate     DateTime
  sessionTime     String?
  providedService String @db.Text
  notes           String? @db.Text
  supervisorId    String

  treatmentProgram PatientTreatmentProgram?

  @@map("media_sessions")
  @@schema("clinic_prosthetics")
}

model PatientTreatmentProgram {
  id                     String   @id @default(uuid())

  workshopSessionId      String?  @unique
  ptSessionId            String?  @unique
  mediaSessionId         String?  @unique

  workshopSession        WorkshopSession? @relation(fields: [workshopSessionId], references: [id], onDelete: Cascade)
  ptSession              PtSession?       @relation(fields: [ptSessionId], references: [id], onDelete: Cascade)
  mediaSession           MediaSession?    @relation(fields: [mediaSessionId], references: [id], onDelete: Cascade)

  description            String?  @db.Text
  sessionStartTime       String?
  sessionEndTime         String?
  technicianId           String?
  technicianSignatureUrl String?
  managerSignatureUrl    String?
  notes                  String?  @db.Text

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("patient_treatment_programs")
  @@schema("clinic_prosthetics")
}

// ── Prosthetic Delivery Form Pro-019 ─────────────────────────────────────────

model ProstheticDeliveryForm {
  id                String          @id @default(uuid())
  caseId            String          @unique
  case              ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  inspectionDate    DateTime?
  prosthetistId     String?
  physiotherapistId String?
  ceoId             String?
  ceoSignatureUrl   String?
  signatureDate     DateTime?

  medicalDirectorId           String?
  medicalDirectorSignatureUrl String?
  medicalDirectorSignedAt     DateTime?

  items             ProstheticDeliveryItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("prosthetic_delivery_forms")
  @@schema("clinic_prosthetics")
}

model ProstheticDeliveryItem {
  id               String                 @id @default(uuid())
  formId           String
  form             ProstheticDeliveryForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  deliveredProduct String?
  partCode         String?
  quantity         Int?
  company          String?
  notes            String?
  itemAddedDate    DateTime?
  isApproved       Boolean  @default(false)
  approvedAt       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([formId])
  @@map("prosthetic_delivery_items")
  @@schema("clinic_prosthetics")
}

// ── Balance Assessment & Exercise Program Form Pro-015 ────────────────────────

model BalanceAssessmentForm {
  id             String          @id @default(uuid())
  caseId         String
  case           ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  assessmentDate DateTime?

  // بيانات المريض الإضافية
  previousProsthesis      Boolean?   // هل استخدم طرف صناعي سابق
  previousProsthesisNotes String?    // تفاصيل اختيارية عند نعم
  assistiveDevice         String?    // NONE | CANE | CRUTCHES | WALKER

  // تقييم التوازن الثابت — [{key, result: INDEPENDENT|ASSISTED|UNABLE}]
  staticBalance     Json?

  // التوازن الديناميكي - مهام — [{key, result: GOOD|FAIR|POOR}]
  dynamicTasks      Json?

  // التوازن الديناميكي - أنشطة — [{key, result: INDEPENDENT|WITH_DIFFICULTY|UNABLE}]
  dynamicActivities Json?

  // تقييم خطر السقوط
  historyOfFalls Boolean?
  nearFalls      Boolean?
  fearOfFalling  Boolean?
  fallRiskLevel  String?   // HIGH | MODERATE | LOW
  fallRiskNotes  String?   @db.Text  // تفاصيل اختيارية عند HIGH

  // خلاصة التوازن
  overallBalanceLevel       String?   // GOOD | FAIR | POOR
  limitingFactors           String[]  @default([])
  limitingFactorsOtherNotes String?   @db.Text

  // برنامج تمارين التوازن — [{exercise, position, dosage, support, notes}]
  exerciseProgram Json?

  // خطة تطوير البرنامج
  programProgression String[] @default([])

  // المراجعة والمتابعة
  followUpWeeks               Int?
  expectedOutcomes            String[] @default([])
  physiotherapistId           String?
  physiotherapistSignatureUrl String?
  committeeHeadId             String?
  committeeHeadSignatureUrl   String?
  followUpDate                DateTime?

  notes String? @db.Text

  isSaved      Boolean   @default(false)
  archivedAt   DateTime?
  archiveNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("balance_assessment_forms")
  @@schema("clinic_prosthetics")
}

// ── Patient Review Program (برنامج مراجعة المريض — بعد اكتمال العلاج) ─────────

model PatientReviewProgram {
  id               String          @id @default(uuid())
  caseId           String
  case             ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sessionDate      DateTime?
  sessionTime      String?
  description      String?  @db.Text
  technicianId     String?
  sessionStartTime String?
  sessionEndTime   String?
  signatureUrl     String?
  notes            String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@map("patient_review_programs")
  @@schema("clinic_prosthetics")
}

// ── Attachments (صور البتر وغيرها) ──────────────────────────────────────────

model CaseAttachment {
  id         String          @id @default(uuid())
  caseId     String
  case       ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  caption    String?

  uploadedAt DateTime        @default(now())
  uploadedBy String

  @@index([caseId])
  @@map("case_attachments")
  @@schema("clinic_prosthetics")
}

// ── Consumables ───────────────────────────────────────────────────────────

model ConsumableUsage {
  id              String @id @default(uuid())
  caseId          String
  case            ProstheticsCase @relation(fields: [caseId], references: [id])

  inventoryItemId String
  consumableName  String
  quantity        Float
  unit            String
  notes           String?
  usedAt          DateTime @default(now())
  usedBy          String
  supervisorId    String

  @@map("consumable_usages")
  @@schema("clinic_prosthetics")
  @@index([caseId])
}

// ── Final Evaluation & Delivery ───────────────────────────────────────────

model FinalEvaluation {
  id     String @id @default(uuid())
  caseId String @unique
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  residualLimbCondition String? @db.Text
  suspensionSystemUsed  String?
  socksDelivered        Int?
  linersDelivered       Int?
  fittingDate           DateTime?
  generalNotes          String? @db.Text
  supervisorId          String?

  physioOpinion                String? @db.Text
  departmentHeadOpinion        String? @db.Text
  prosthetistOpinion           String? @db.Text
  prosthetistSupervisorOpinion String? @db.Text
  committeeHeadOpinion         String? @db.Text
  expertOpinion                String? @db.Text

  readyForDelivery      Boolean @default(false)
  needsFollowUp         Boolean @default(false)
  followUpPlan          String? @db.Text
  medicalDirectorNotes  String? @db.Text

  medicalDirectorSignatureBase64 String? @db.Text
  medicalDirectorSignedAt        DateTime?
  medicalDirectorIp              String?

  patientFileComplete   Boolean @default(false)
  managerNotes          String? @db.Text
  managerSignatureBase64 String? @db.Text
  managerSignedAt       DateTime?

  @@map("final_evaluations")
  @@schema("clinic_prosthetics")
}

model Delivery {
  id     String @id @default(uuid())
  caseId String @unique
  case   ProstheticsCase @relation(fields: [caseId], references: [id])

  deliveryDate      DateTime
  prosthetistId     String
  physiotherapistId String
  deliveredItems    Json

  patientSignatureBase64 String? @db.Text
  patientSignedAt        DateTime?

  managerId              String
  managerSignatureBase64 String? @db.Text
  managerSignedAt        DateTime?

  @@map("deliveries")
  @@schema("clinic_prosthetics")
}

model FollowUp {
  id             String @id @default(uuid())
  caseId         String
  case           ProstheticsCase @relation(fields: [caseId], references: [id])
  visitDate      DateTime
  findings       String @db.Text
  actions        String? @db.Text
  practitionerId String

  @@map("follow_ups")
  @@schema("clinic_prosthetics")
  @@index([caseId])
}

// ── Case Treatment Program Pro-004 (مرتبط بالحالة مباشرة، متعدد) ─────────

model CaseTreatmentProgram {
  id                     String          @id @default(uuid())
  caseId                 String
  case                   ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sessionDate            DateTime?
  sessionTime            String?
  sessionStartTime       String?
  sessionEndTime         String?
  description            String?  @db.Text
  technicianId           String?
  technicianSignatureUrl String?
  managerSignatureUrl    String?
  notes                  String?  @db.Text
  archivedAt             DateTime?
  archiveNotes           String?  @db.Text

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([caseId])
  @@map("case_treatment_programs")
  @@schema("clinic_prosthetics")
}

// ── Gait Analysis Form Pro-016 (متعدد لكل حالة) ──────────────────────────

model GaitAnalysisForm {
  id     String @id @default(uuid())
  caseId String
  case   ProstheticsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sessionDate DateTime?

  // تفاصيل الطرف الصناعي
  suspensionSystem String[] @default([])
  socketBearing    String?
  kneeJointType    String?
  footType         String?

  // شكوى المريض
  patientComplaints String[] @default([])
  painIntensity     Int?

  // فحص الجذمور والطرف
  alignmentCheck            String?
  hasRomLimitations         Boolean?
  hasHipFlexionContracture  Boolean?
  hasKneeFlexionContracture Boolean?
  weakHipAbductors          Boolean?
  weakHipExtensors          Boolean?
  weakTrunkMuscles          Boolean?
  otherWeakness             String?

  // التقييم الأساسي (Core Assessment + Balance)
  trunkStability   String?
  abdominalControl String?
  pelvicControl    String?
  sittingBalance   String?
  standingBalance  String?

  // قياسات المشي الزمانية-المكانية
  assistiveDevice      String?
  speedMs              Float?
  cadence              Int?
  stepLengthProsCm     Float?
  stepLengthSoundCm    Float?
  stancePercProsthetic Float?
  stancePercSound      Float?
  symmetry             String?

  // انحرافات المشي — JSON لكل مرحلة: {deviations: string[], possibleCause: string}
  initialContact  Json?
  loadingResponse Json?
  midStance       Json?
  terminalStance  Json?
  preSwing        Json?
  swingPhase      Json?
  gaitNotes       String? @db.Text

  // مشاكل خاصة بالطرف الصناعي
  prostheticIssues String[] @default([])

  // الاستنتاج السريري
  mainProblem  String?  @db.Text
  likelyCauses String[] @default([])

  // التوصيات
  recommendations      String[] @default([])
  recommendationsNotes String?  @db.Text

  // خطة العلاج (Rehab Plan) — {strengthening: string[], balanceTrain: string[], gaitTrain: string[]}
  rehabPlan  Json?
  rehabNotes String? @db.Text

  // ملاحظات التشخيص
  mainProblemNotes String? @db.Text

  // ملاحظات "أخرى" للحقول المتعددة
  patientComplaintsOtherNotes String?  @db.Text
  suspensionSystemOtherNotes  String?
  prostheticIssuesOtherNotes  String?  @db.Text
  likelyCausesOtherNotes      String?  @db.Text

  // التوقيعات
  examinerProsthetistId       String?
  prosthetistSignatureUrl     String?
  examinerPhysiotherapistId   String?
  physiotherapistSignatureUrl String?

  notes String? @db.Text

  isSaved      Boolean   @default(false)
  archivedAt   DateTime?
  archiveNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("gait_analysis_forms")
  @@schema("clinic_prosthetics")
}
