generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["evaluation"]
}

// دورات التقييم
model EvaluationPeriod {
  id          String   @id @default(uuid())
  code        String   @unique
  nameAr      String
  nameEn      String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      PeriodStatus @default(DRAFT)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  forms       EvaluationForm[]

  @@schema("evaluation")
}

enum PeriodStatus {
  DRAFT
  OPEN
  CLOSED

  @@schema("evaluation")
}

// معايير التقييم
model EvaluationCriteria {
  id              String   @id @default(uuid())
  code            String   @unique
  nameAr          String
  nameEn          String?
  descriptionAr   String?
  descriptionEn   String?
  weight          Float    @default(1.0) // وزن المعيار في النتيجة النهائية
  maxScore        Int      @default(5)
  category        CriteriaCategory
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections        EvaluationSection[]

  @@schema("evaluation")
}

enum CriteriaCategory {
  PERFORMANCE      // الأداء الوظيفي
  BEHAVIOR         // السلوك المهني
  SKILLS           // المهارات
  ACHIEVEMENT      // الإنجازات
  DEVELOPMENT      // التطوير الذاتي

  @@schema("evaluation")
}

// نماذج التقييم
model EvaluationForm {
  id                    String   @id @default(uuid())
  periodId              String
  employeeId            String   // Reference to Users Service
  evaluatorId           String?  // المقيّم (Manager)

  // Self Evaluation
  selfStatus            FormStatus @default(NOT_STARTED)
  selfScore             Float?
  selfSubmittedAt       DateTime?
  selfComments          String?

  // Manager Evaluation
  managerStatus         FormStatus @default(NOT_STARTED)
  managerScore          Float?
  managerSubmittedAt    DateTime?
  managerComments       String?
  managerStrengths      String?
  managerWeaknesses     String?
  managerRecommendations String?

  // HR Review
  hrReviewedBy          String?
  hrReviewedAt          DateTime?
  hrComments            String?
  hrRecommendation      HRRecommendation?

  // GM Approval
  gmApprovedBy          String?
  gmApprovedAt          DateTime?
  gmStatus              ApprovalStatus?
  gmComments            String?

  // Final
  finalScore            Float?
  finalRating           FinalRating?
  status                EvaluationStatus @default(PENDING_SELF)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  period                EvaluationPeriod @relation(fields: [periodId], references: [id])
  sections              EvaluationSection[]
  peerEvaluations       PeerEvaluation[]
  goals                 EmployeeGoal[]

  @@unique([periodId, employeeId])
  @@schema("evaluation")
}

enum FormStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED

  @@schema("evaluation")
}

enum EvaluationStatus {
  PENDING_SELF
  SELF_SUBMITTED
  PENDING_MANAGER
  MANAGER_SUBMITTED
  PENDING_HR_REVIEW
  HR_REVIEWED
  PENDING_GM_APPROVAL
  COMPLETED

  @@schema("evaluation")
}

enum HRRecommendation {
  PROMOTION           // ترقية
  SALARY_INCREASE     // زيادة راتب
  BONUS               // مكافأة
  TRAINING            // تدريب
  WARNING             // إنذار
  TERMINATION         // إنهاء خدمة
  NO_ACTION           // لا إجراء

  @@schema("evaluation")
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  NEEDS_REVISION

  @@schema("evaluation")
}

enum FinalRating {
  EXCELLENT           // ممتاز (90-100)
  VERY_GOOD           // جيد جداً (80-89)
  GOOD                // جيد (70-79)
  SATISFACTORY        // مقبول (60-69)
  NEEDS_IMPROVEMENT   // يحتاج تحسين (أقل من 60)

  @@schema("evaluation")
}

// أقسام التقييم (لكل نموذج)
model EvaluationSection {
  id              String   @id @default(uuid())
  formId          String
  criteriaId      String

  // Self Evaluation
  selfScore       Int?
  selfComments    String?

  // Manager Evaluation
  managerScore    Int?
  managerComments String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  form            EvaluationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  criteria        EvaluationCriteria @relation(fields: [criteriaId], references: [id])

  @@unique([formId, criteriaId])
  @@schema("evaluation")
}

// تقييم الأقران
model PeerEvaluation {
  id              String   @id @default(uuid())
  formId          String
  peerId          String   // الموظف الذي يقيّم
  rating          PeerRating
  strengths       String?
  improvements    String?
  comments        String?
  isAnonymous     Boolean  @default(true)
  submittedAt     DateTime @default(now())

  form            EvaluationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, peerId])
  @@schema("evaluation")
}

enum PeerRating {
  EXCELLENT
  VERY_GOOD
  GOOD
  SATISFACTORY
  NEEDS_IMPROVEMENT

  @@schema("evaluation")
}

// أهداف الموظف
model EmployeeGoal {
  id              String   @id @default(uuid())
  formId          String
  title           String
  description     String?
  targetDate      DateTime? @db.Date
  weight          Float    @default(1.0)

  // Self Assessment
  selfAchievement Float?   // نسبة الإنجاز من وجهة نظر الموظف (0-100)
  selfComments    String?

  // Manager Assessment
  managerAchievement Float? // نسبة الإنجاز من وجهة نظر المدير (0-100)
  managerComments String?

  status          GoalStatus @default(IN_PROGRESS)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  form            EvaluationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@schema("evaluation")
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("evaluation")
}

// سجل التغييرات (Audit)
model EvaluationHistory {
  id              String   @id @default(uuid())
  formId          String
  action          String   // SELF_SUBMITTED, MANAGER_SUBMITTED, HR_REVIEWED, etc.
  performedBy     String
  details         String?
  timestamp       DateTime @default(now())

  @@index([formId])
  @@schema("evaluation")
}

// =============================================
// تقييم فترة التجربة
// =============================================

model ProbationCriteria {
  id                 String   @id @default(uuid())
  nameAr             String
  nameEn             String?
  isCore             Boolean  @default(false)
  isActive           Boolean  @default(true)
  displayOrder       Int      @default(0)
  targetEmployeeId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scores            ProbationCriteriaScore[]
  jobTitleOverrides JobTitleCriteria[]

  @@schema("evaluation")
}

model JobTitleCriteria {
  jobTitleId   String
  criteriaId   String
  isEnabled    Boolean  @default(true)
  displayOrder Int?

  criteria ProbationCriteria @relation(fields: [criteriaId], references: [id])

  @@id([jobTitleId, criteriaId])
  @@schema("evaluation")
}

model ProbationEvaluation {
  id                    String              @id @default(uuid())
  employeeId            String
  hireDate              DateTime            @db.Date
  probationEndDate      DateTime            @db.Date
  evaluationDate        DateTime?           @db.Date
  evaluatorId           String
  evaluatorNotes        String?
  isDelegated           Boolean             @default(false)
  delegationNote        String?
  seniorManagerId       String?
  seniorManagerNotes    String?
  hrManagerId           String?
  hrManagerNotes        String?
  ceoId                 String?
  ceoRecommendations    String?
  finalRecommendation   ProbationRecommendation?
  workAreasNote         String?
  status                ProbationStatus     @default(DRAFT)
  employeeAcknowledgedAt DateTime?
  employeeAcknowledged  Boolean             @default(false)
  employeeNotes         String?
  overallRating         Float?

  // ما هو انجاز قمت به خلال الفترة التي قضيتها بالعمل معنا (بند بالتقييم الذاتي)
  employeeAchievementNote    String?  @db.Text
  employeeAchievementFileUrl String?

  // حقول حساب الدرجات المرجّحة 70/30
  managerScorePercent   Float?
  selfScorePercent      Float?
  finalScorePercent     Float?
  managerWeight         Float    @default(0.7)
  selfWeight            Float    @default(0.3)

  // حقول جدولة الاجتماع
  meetingProposedAt          DateTime?
  meetingConfirmedByEmployee Boolean   @default(false)
  meetingConfirmedByManager  Boolean   @default(false)
  meetingConfirmedByCeo      Boolean   @default(false)
  meetingConfirmedAt         DateTime?
  meetingRescheduleNote      String?
  decisionDocumentUrl        String?
  meetingSkipped             Boolean   @default(false)
  meetingSkippedAt           DateTime?
  meetingSkippedBy           String?
  meetingSkipReason          String?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  scores  ProbationCriteriaScore[]
  history ProbationEvaluationHistory[]

  @@schema("evaluation")
}

enum ProbationStatus {
  DRAFT
  PENDING_SELF_EVALUATION
  PENDING_DIRECT_MANAGER
  PENDING_SENIOR_MANAGER
  PENDING_HR
  PENDING_CEO
  PENDING_MEETING_SCHEDULE
  PENDING_EMPLOYEE_ACKNOWLEDGMENT
  COMPLETED
  REJECTED_BY_SENIOR
  REJECTED_BY_HR
  REJECTED_BY_CEO

  @@schema("evaluation")
}

enum ProbationRecommendation {
  EXTEND_PROBATION
  CONFIRM_POSITION
  TRANSFER_POSITION
  SALARY_RAISE
  TERMINATE

  @@schema("evaluation")
}

model ProbationCriteriaScore {
  evaluationId String
  criteriaId   String
  selfScore    Int?
  score        Int?

  evaluation ProbationEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criteria   ProbationCriteria   @relation(fields: [criteriaId], references: [id])

  @@id([evaluationId, criteriaId])
  @@schema("evaluation")
}

model ProbationEvaluationHistory {
  id           String   @id @default(uuid())
  evaluationId String
  action       String
  performedBy  String
  notes        String?
  createdAt    DateTime @default(now())

  evaluation ProbationEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@schema("evaluation")
}

// ═══════════════════════════════════════════════════════════════════════════
// تقييم الأداء 360 درجة (نصف سنوي) — وحدة جديدة مستقلة عن EvaluationForm.
// المرجع: «الدليل الإداري والفني الشامل لنظام تقييم الأداء 360 درجة والحوافز»
// + قرارات الموارد البشرية المعتمدة (16 تشرين الثاني 2026).
// ستة محاور بأوزان ثابتة: مدير 40، رضا عملاء 20، زملاء 10، مرؤوسون 10، التزام 10، ذاتي 10.
// المحور غير المنطبق يُعاد توزيع وزنه نسبياً على البقية (التطبيع).
// ═══════════════════════════════════════════════════════════════════════════

enum AppraisalAxis {
  MANAGER     // تقييم المدير المباشر — يدوي
  CUSTOMER    // رضا العملاء — آلي من استبيانات المرضى
  PEER        // الزملاء — يدوي، مجهول
  UPWARD      // المرؤوسون للمدير — يدوي، مجهول
  COMMITMENT  // الالتزام والدوام — آلي
  SELF        // الذاتي + مرفق الإنجازات — يدوي

  @@schema("evaluation")
}

enum AppraisalCycleStatus {
  DRAFT      // قيد الإعداد — لا يرى الموظفون شيئاً
  OPEN       // مفتوحة لإدخال التقييمات
  CLOSED     // أُغلق الإدخال — الحساب ممكن
  FINALIZED  // النتائج مجمَّدة ومعلنة للموظفين

  @@schema("evaluation")
}

enum AppraisalSatisfactionSource {
  PROSTHETICS // استبيانات الأطراف
  PHYSIO      // استبيانات العلاج الفيزيائي
  PODIATRY    // استبيانات صحة القدم

  @@schema("evaluation")
}

enum AppraisalSubmissionStatus {
  DRAFT
  SUBMITTED

  @@schema("evaluation")
}

enum AppraisalBonusTier {
  EXCEPTIONAL // 90-100 بونص استثنائي
  HIGH        // 80-89 بونص مرتفع
  BASIC       // 70-79 بونص أساسي
  PIP         // أقل من 70 — خطة تحسين أداء بلا بونص

  @@schema("evaluation")
}

model AppraisalCycle {
  id          String               @id @default(uuid())
  code        String               @unique
  nameAr      String
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  status      AppraisalCycleStatus @default(DRAFT)
  openedAt    DateTime?
  closedAt    DateTime?
  finalizedAt DateTime?
  finalizedBy String?
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  submissions AppraisalSubmission[]
  results     AppraisalResult[]

  @@schema("evaluation")
}

// الأسئلة ثابتة من الدليل وتُزرع مع الـ migration — لا endpoint لتعديلها
model AppraisalQuestion {
  id           String        @id
  axis         AppraisalAxis
  displayOrder Int
  textAr       String
  maxScore     Int
  isActive     Boolean       @default(true)

  answers AppraisalAnswer[]

  @@unique([axis, displayOrder])
  @@schema("evaluation")
}

// تقييم واحد من مقيِّم لمقيَّم على محور يدوي (MANAGER/PEER/UPWARD/SELF).
// evaluatorId و evaluateeId = users.employees.id (بلا FK — خدمة منفصلة)
model AppraisalSubmission {
  id                 String                    @id @default(uuid())
  cycleId            String
  axis               AppraisalAxis
  evaluateeId        String
  evaluatorId        String
  status             AppraisalSubmissionStatus @default(DRAFT)
  comments           String?                   @db.Text
  achievementNote    String?                   @db.Text // SELF فقط
  achievementFileUrl String?                   // SELF فقط
  scorePercent       Float?                    // يُحسب عند الإرسال: مجموع الدرجات ÷ مجموع الحد الأعلى × 100
  submittedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  cycle   AppraisalCycle    @relation(fields: [cycleId], references: [id])
  answers AppraisalAnswer[]

  @@unique([cycleId, axis, evaluateeId, evaluatorId])
  @@index([cycleId, evaluateeId])
  @@index([cycleId, evaluatorId])
  @@schema("evaluation")
}

model AppraisalAnswer {
  submissionId String
  questionId   String
  score        Int

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AppraisalQuestion   @relation(fields: [questionId], references: [id])

  @@id([submissionId, questionId])
  @@schema("evaluation")
}

// قرار 3: علامة على القسم. وجود السطر = القسم مصنَّف.
// satisfactionSource فاضي = قسم إداري (خارج المركز) ← محور رضا العملاء غير منطبق.
model AppraisalDepartmentConfig {
  departmentId       String                       @id
  satisfactionSource AppraisalSatisfactionSource?
  updatedBy          String?
  updatedAt          DateTime                     @updatedAt

  @@schema("evaluation")
}

// قرار 4: المسميات الوظيفية لثلاثي «جاهزية المركز» (مشرفة المركز، الخدمات، الأمن)
model AppraisalReadinessJobTitle {
  jobTitleId String   @id
  createdAt  DateTime @default(now())

  @@schema("evaluation")
}

// قرار 1: أرقام مؤشر الالتزام — سطر واحد (id = 1)
model AppraisalSettings {
  id                         Int      @id @default(1)
  penaltyPoints              Float    @default(1)
  justificationPoints        Float    @default(0.25)
  excessLeaveDayPoints       Float    @default(0.5)
  excessLeaveHourPoints      Float    @default(0.25)
  starOfMonthPoints          Float    @default(1)
  monthlyLeaveDaysAllowance  Float    @default(1)
  monthlyLeaveHoursAllowance Float    @default(2)
  countedLeaveTypeCodes      String[]
  updatedBy                  String?
  updatedAt                  DateTime @updatedAt

  @@schema("evaluation")
}

// النتيجة المحسوبة لكل موظف — تُعاد حسابها حتى تجميد الدورة (FINALIZED)
model AppraisalResult {
  id                String              @id @default(uuid())
  cycleId           String
  employeeId        String
  managerPercent    Float?
  customerPercent   Float?
  peerPercent       Float?
  upwardPercent     Float?
  commitmentPercent Float?
  selfPercent       Float?
  peerCount         Int                 @default(0)
  upwardCount       Int                 @default(0)
  appliedWeights    Json                // الأوزان بعد التطبيع
  missingAxes       String[]            // محاور مطلوبة لم تُدخل بعد (MANAGER/SELF)
  details           Json                // تفاصيل الحساب الآلي + لقطة القسم/الدرجة
  finalScore        Float?              // فاضي طالما في محاور مطلوبة ناقصة
  bonusTier         AppraisalBonusTier?
  computedAt        DateTime            @default(now())

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id])

  @@unique([cycleId, employeeId])
  @@schema("evaluation")
}
