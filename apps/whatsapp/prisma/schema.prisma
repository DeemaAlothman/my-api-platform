datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["whatsapp"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum SendStatus {
  SENT
  FAILED
  SKIPPED_NO_PHONE

  @@schema("whatsapp")
}

// سجل إرسال كل إشعار عبر واتساب — جدول جديد بالكامل، صفر لمسة لجدول
// users.notifications الأصلي. notificationId فريد حتى ما ينبعت نفس الإشعار مرتين
model WhatsAppLog {
  id             String     @id @default(uuid())
  notificationId String     @unique // مرجع خارجي لـ users.notifications — بلا FK
  userId         String // مرجع خارجي لـ users.users
  phone          String?
  status         SendStatus
  errorMessage   String?    @db.Text
  sentAt         DateTime?
  createdAt      DateTime   @default(now())

  @@map("whatsapp_logs")
  @@schema("whatsapp")
}
