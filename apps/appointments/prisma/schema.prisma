generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["clinic_appointments"]
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum CaseType {
  PROSTHETICS
  PHYSIO
  GENERAL
  @@schema("clinic_appointments")
}

enum AppointmentType {
  ASSESSMENT
  FITTING
  SESSION
  FOLLOW_UP
  COMMITTEE
  EXAMINATION
  // قسم الأطراف الصناعية وطب الأقدام
  REHABILITATION
  COMPANY_EXAMINATION
  REFERRAL_EXAMINATION
  TRIAL_DELIVERY
  FINAL_DELIVERY
  REVIEW
  IMPRESSION_TAKING
  MEASUREMENT_TAKING
  WHEELCHAIR_DELIVERY
  WARRANTY_DELIVERY
  COSMETIC_DELIVERY
  ANALYSIS
  INSTALLATION
  // الإدارة الطبية (المعاينات العظمية)
  ORTHOPEDIC_EXAMINATION
  FOOT_ANALYSIS_EXAMINATION
  LIMB_PATIENT_EXAMINATION
  // قسم المقومات
  ORTHOTICS
  @@schema("clinic_appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  LATE
  APOLOGIZED
  SCHEDULED_CONTACTED
  @@schema("clinic_appointments")
}

enum ReminderChannel {
  MAIL
  WHATSAPP
  @@schema("clinic_appointments")
}

enum Gender {
  MALE
  FEMALE
  @@schema("clinic_appointments")
}

enum ArrivalMethod {
  SOCIAL_MEDIA
  HOSPITAL
  DOCTOR
  ASSOCIATION
  FRIEND
  STAFF
  @@schema("clinic_appointments")
}

enum WaitingListStatus {
  WAITING
  SCHEDULED
  NOT_SCHEDULED
  @@schema("clinic_appointments")
}

enum InternalMeetingType {
  MEETING
  TRAINING
  PHOTOGRAPHY
  LECTURE
  EVENT
  EXTERNAL_MISSION
  VISIT
  OTHER
  @@schema("clinic_appointments")
}

enum InternalMeetingStatus {
  SCHEDULED
  CANCELLED
  @@schema("clinic_appointments")
}

// ── Model ─────────────────────────────────────────────────────────────────

model Appointment {
  id               String   @id @default(uuid())
  patientId        String?
  patientName      String?
  contactNumber    String?  // لمواعيد غير المسجّلين (بدون patientId) — لمطابقة قائمة الانتظار
  caseId           String?
  caseType         CaseType?

  practitionerId      String
  practitionerRole    String?
  departmentId        String?
  physiotherapistId   String?
  therapistIds        String[]

  appointmentType  AppointmentType
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int      @default(60)
  isOpenEnded      Boolean  @default(false)

  status           AppointmentStatus @default(SCHEDULED)

  notes            String? @db.Text

  reminderSentAt   DateTime?
  reminderChannel  ReminderChannel?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String
  cancelledReason  String?
  // محسوبة ومخزَّنة لحظة الإنشاء فقط (حسب VTX-JTL-000011) — null للمواعيد الأقدم من هالميزة،
  // لا تُعاد حسابها لاحقاً حتى لو تغيّر مسمى المنشئ بعدين
  createdBySupervisor Boolean?

  waitingListEntry WaitingListEntry?

  @@map("appointments")
  @@schema("clinic_appointments")
  @@index([practitionerId, startTime])
  @@index([patientId])
  @@index([status])
  @@index([startTime])
}

model WaitingListEntry {
  id               String   @id @default(uuid())

  patientName      String
  gender           Gender
  age              Int?
  registrationDate DateTime @default(now())
  arrivalMethod    ArrivalMethod?
  serviceType      String?          // تضل مؤقتاً للسجلات القديمة — السجلات الجديدة تستخدم appointmentType
  appointmentType  AppointmentType?
  contactNumber    String
  priority         Int
  notes            String? @db.Text

  status           WaitingListStatus @default(WAITING)

  appointmentId    String?     @unique
  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String

  @@map("waiting_list_entries")
  @@schema("clinic_appointments")
  @@index([status])
  @@index([priority])
}

// العملاء المحتملين — جدول مستقل عن قائمة الانتظار (بدون أولوية وبدون حالة)
model PotentialClient {
  id                String   @id @default(uuid())

  patientName       String
  gender            Gender
  age               Int?
  registrationDate  DateTime @default(now())
  arrivalMethod     ArrivalMethod?
  interestedService String
  contactNumber     String
  residence         String?  // مكان الإقامة
  notes             String? @db.Text

  // null = لم يُحدَّد بعد
  visitedCenter     Boolean?  // زار المركز؟
  paidVisit         Boolean?  // استفاد بدفع فعلي؟ (مستقل عن visitedCenter)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String

  attachments PotentialClientAttachment[]

  @@map("potential_clients")
  @@schema("clinic_appointments")
  @@index([registrationDate])
}

model PotentialClientAttachment {
  id                String          @id @default(uuid())
  potentialClientId String
  potentialClient   PotentialClient @relation(fields: [potentialClientId], references: [id], onDelete: Cascade)

  fileUrl    String
  fileName   String
  fileSize   Int
  mimeType   String

  uploadedAt DateTime @default(now())
  uploadedBy String

  @@index([potentialClientId])
  @@map("potential_client_attachments")
  @@schema("clinic_appointments")
}

// اجتماع/تدريب داخلي — مستقل تماماً عن مواعيد علاج المرضى، لكل الحضور (userId) يُتحقَّق أولاً
// من عدم وجود جلسة علاج (أطراف/طب أقدام/فيزيائي) لنفس الوقت قبل الإنشاء
model InternalMeeting {
  id          String                @id @default(uuid())
  title       String
  meetingType InternalMeetingType
  meetingTypeOther String?          // نص حر فقط لما meetingType = OTHER
  attendeeIds String[]              // userId[] — نفس نوع practitionerId/therapistIds بجدول Appointment
  startTime   DateTime
  endTime     DateTime
  notes       String?               @db.Text
  status      InternalMeetingStatus @default(SCHEDULED)
  cancelledReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  @@map("internal_meetings")
  @@schema("clinic_appointments")
  @@index([startTime])
}
