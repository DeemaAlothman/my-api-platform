generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["clinic_appointments"]
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum CaseType {
  PROSTHETICS
  PHYSIO
  GENERAL
  @@schema("clinic_appointments")
}

enum AppointmentType {
  ASSESSMENT
  FITTING
  SESSION
  FOLLOW_UP
  COMMITTEE
  EXAMINATION
  // قسم الأطراف الصناعية وطب الأقدام
  COMPANY_EXAMINATION
  REFERRAL_EXAMINATION
  TRIAL_DELIVERY
  FINAL_DELIVERY
  REVIEW
  IMPRESSION_TAKING
  MEASUREMENT_TAKING
  WHEELCHAIR_DELIVERY
  WARRANTY_DELIVERY
  COSMETIC_DELIVERY
  ANALYSIS
  INSTALLATION
  // الإدارة الطبية (المعاينات العظمية)
  ORTHOPEDIC_EXAMINATION
  FOOT_ANALYSIS_EXAMINATION
  LIMB_PATIENT_EXAMINATION
  @@schema("clinic_appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  @@schema("clinic_appointments")
}

enum ReminderChannel {
  MAIL
  WHATSAPP
  @@schema("clinic_appointments")
}

// ── Model ─────────────────────────────────────────────────────────────────

model Appointment {
  id               String   @id @default(uuid())
  patientId        String?
  patientName      String?
  caseId           String?
  caseType         CaseType?

  practitionerId      String
  practitionerRole    String?
  departmentId        String?
  physiotherapistId   String?
  therapistIds        String[]

  appointmentType  AppointmentType
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int      @default(60)
  isOpenEnded      Boolean  @default(false)

  status           AppointmentStatus @default(SCHEDULED)

  notes            String? @db.Text

  reminderSentAt   DateTime?
  reminderChannel  ReminderChannel?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String
  cancelledReason  String?

  @@map("appointments")
  @@schema("clinic_appointments")
  @@index([practitionerId, startTime])
  @@index([patientId])
  @@index([status])
  @@index([startTime])
}
