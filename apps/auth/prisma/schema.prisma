generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  fullName  String
  password  String
  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String

  revoked   Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// لا يُقرأ هذا النموذج ولا يُكتَب به: رابطُ الخدمة يشير إلى سكيما users، وهذا
// الجدول يسكن سكيما auth لأنه الجدول الذي يقرؤه حارسُ التوكن في المكتبة المشتركة
// في كل الخدمات. فالوصولُ إليه بـ SQL صريحٍ مؤهَّلٍ بسكيماه، لا عبر Prisma.
// يبقى النموذجُ وصفاً للجدول وحدَّاً لشكله.
model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("revoked_tokens")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}
